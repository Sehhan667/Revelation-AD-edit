//======// Main //================================================================================//
void main() {
	// SharedPreload();

	uvec2 localPos = QuadLayout8x8(gl_LocalInvocationIndex);
	ivec2 texelPos = ivec2(localPos + gl_WorkGroupID.xy * gl_WorkGroupSize.xy);

	// GI 画布尺寸（半分辨率 = 屏幕一半；全分辨率 = 屏幕）
#ifdef VXGI_FULLRES
	ivec2 canvasEnd = ivec2(viewSize);
	float canvasHeight = viewSize.y;
#else
	ivec2 canvasEnd = ivec2(halfViewSize);
	float canvasHeight = halfViewSize.y;
#endif

	// [FIX 2026-08-06] 光追降噪关闭（settings.glsl 注释 VOXEL_GI_DENOISE）时：
	// 透传 colortex3（保持棋盘信号，不做边缘保持滤波）。SSILVB 不受影响（非光追模式正常降噪）。
	#ifdef GI_ACTIVE_VXGI
		#ifndef VOXEL_GI_DENOISE
			imageStore(EAWF_DST, texelPos, imageLoad(EAWF_SRC, texelPos));
			return;
		#endif
	#endif

	// [2026-08-19] 离线渲染（settings.glsl 取消注释 #define OFFLINE_RENDER）：
	// 屏蔽空间降噪——透传 colortex3（Accumulate 的时域累积结果），不做边缘保持滤波；
	// 靠时域持续累积收敛，F2 出高画质静帧。关闭宏则此分支不参与，与之前完全一致。
	#ifdef OFFLINE_RENDER
		imageStore(EAWF_DST, texelPos, imageLoad(EAWF_SRC, texelPos));
		return;
	#endif

	// [2026-08-19 NRD] 去遮挡：colortex14.a=1=不可靠(新暴露/重投影失效)，0=可靠。
	f16vec4 normalDepthData = f16vec4(texelFetch(colortex14, texelPos, 0));
	// disoccF = a × NRD_DISOCCLUSION（滑条=不可靠时最大强化量；0=关闭）。
	// 空间步长放大 (1+disoccF) 快速跨邻居补填；sigma 放松 (1/(1+disoccF)) 降边缘保持，
	// 让该像素更多吸收周围可靠样本、几帧内收敛，避免"糊块+长拖影"。
	float disoccF = float(normalDepthData.a) * NRD_DISOCCLUSION;
	float stepBoost  = 1.0 + disoccF;
	float sigmaRelax = 1.0 / (1.0 + disoccF);
	// vec2 depthGradient = vec2(dFdx(normalDepthData.w), dFdy(normalDepthData.w));

	// 0.0625 0.125 0.0625
	// 0.125  0.25  0.125
	// 0.0625 0.125 0.0625
	// 3×3 kernel used multiple times in the algorithm

	const float kernel[8] = {0.0625, 0.125, 0.0625, 0.125, 0.125, 0.0625, 0.125, 0.0625};

	// [④ minHitDistanceWeight] 官方 `minHitDistanceWeight = 0.1`：命中越近（归一化命中距离越小）
	// 的样本越容易受阴影/遮挡影响，空间 pass 里应降权。归一化命中距离由 ① prepass 写进
	// `colortex22.a`（官方 ReblurHitDistanceParameters 的 saturate(hitDistance / (A + viewZ*B))）。
	const float MIN_HITDIST_WEIGHT = 0.1;
	// 声明必须放在所有使用者（fireflyRef / centerLuma）之前，否则 GLSL 报 C1503 undefined。
	f16vec4 filteredColVar = f16vec4(imageLoad(EAWF_SRC, texelPos));
	// [⑦ firefly 抑制] 官方 `enableAntiFirefly = true`、`fireflySuppressorMinRelativeScale = 2.0`
	// （原文：undesired sporadic outliers suppression to keep output stable；smaller = 更强抑制、更大偏差）。
	// 参考取稳定化辐射（self-guided 引导），把每个 tap 钳到 `参考 × 2`：孤亮点无法主导加权。
	const float FIREFLY_SCALE = 2.0;
#ifdef VOXEL_GI_NRD_ACTIVE
	// 稳定化缓冲是屏幕空间的，没有重投影：新暴露像素的 colortex23 里还是**旧表面**的值。
	// 直接拿它当引导/火fly参考，会把新像素按旧值压住 ⇒ 移动时新像素剧烈跳。
	// 用本像素的累积帧数给 guide 加权：a≤2 完全不信（用自身），a≥10 完全信稳定化值。
	float _histLenC = texelFetch(colortex2, texelPos, 0).a;
	float _guideTrustC = saturate((_histLenC - 2.0) * 0.125);
	vec3 _stabC = texelFetch(colortex23, texelPos, 0).rgb;
	vec3 fireflyRef = mix(filteredColVar.rgb, _stabC, _guideTrustC);
#else
	vec3 fireflyRef = filteredColVar.rgb;   // 非 NRD：没有稳定化缓冲，用自身当参考
#endif
	// 稳定化缓冲首帧/未就绪时为 0：此时不能用它当参考（否则把整屏钳到 ~0），
	// 退回用本帧滤波对象自身作为参考（等价于"这一帧不做额外抑制"）。
	if (max(max(fireflyRef.r, fireflyRef.g), fireflyRef.b) <= 1e-6) fireflyRef = filteredColVar.rgb;
	vec3 fireflyCeil = max(fireflyRef, vec3(1e-6)) * FIREFLY_SCALE;
#ifdef VOXEL_GI_NRD_ACTIVE
	// 新像素（历史很短）不参与火fly钳制：参考本身不可信，钳了反而把真实亮部压掉。
	if (_guideTrustC < 0.05) fireflyCeil = vec3(FP16_MAX);
#endif
	// [③ self-guided] 官方 REBLUR 的空间滤波是 self-guided：引导信号用**稳定化后的历史**
	// (stabilized radiance，我们放在 colortex23)，而不是当前噪声输入。这样边缘保持权重
	// 不会随每帧噪声跳动 —— 这正是官方消除滤波输出残余起伏的办法。
	// 数据仍取 colorimg3（本帧滤波对象），只有**权重用的亮度**换成稳定化值。
#if defined VOXEL_GI_NRD_ACTIVE
	// GI_BISECT bit0：临时退回"噪声输入引导"，用来判断静止不稳是否来自稳定化引导
	float16_t centerLuma = (GI_BISECT & 1) == 0
	    ? float16_t(mix(filteredColVar.r, _stabC.r, _guideTrustC))
	    : filteredColVar.r;
	if (centerLuma <= 1e-6) centerLuma = filteredColVar.r;
#else
	float16_t centerLuma = filteredColVar.r;   // 非 NRD：退回 SVGF 式（引导=输入）
#endif
	if (centerLuma <= 1e-6) centerLuma = filteredColVar.r;   // 首帧/未就绪兜底
	filteredColVar.rgb = min(filteredColVar.rgb, f16vec3(fireflyCeil));   // ⑦ 中心同样钳制（须在声明之后）

	float frameIndex = texelFetch(colortex2, texelPos, 0).a;
	// [2026-08-09 同步官方 SVGF] 历史帧因子：帧数越多信任度越高
	// [2026-08-19 NRD] 可靠性权重（见宏注释）：0=关闭用回原硬阈值线性；否则用指数可靠性。
	// [2026-11-08] 曾量化到 1/8 步长（压"滤波强度逐帧抖"），实测会在画面上留下**阶梯分界线**
	// （historyFactor 乘在 sigmaL/sigmaN 上，量化 = 保边强度逐级跳）⇒ 已撤销。
	// 真正的逐帧不稳定来源是滤波 tap 的逐帧抖动，已在 `sampleTexelBase` 处修掉。
	float16_t historyFactor;
	if (NRD_RELIABILITY <= 0.0) {
	    historyFactor = float16_t(saturate(frameIndex * 0.1 - 0.125));
	} else {
	    historyFactor = float16_t(1.0 - exp2(-frameIndex * NRD_RELIABILITY));
	}

	// [2026-08-28 欠采样增强] 时域累积帧数少（刚出现/刚重投影）→ 该处噪声高，
	// 放大空间步长 + 放松边缘保持，让空间滤波更快用周围可靠邻居收敛。
	{
	    float _under = clamp(10.0 - frameIndex, 0.0, 10.0) * 0.1; // 0..1，少于 ~10 帧
	    stepBoost  *= 1.0 + _under * 0.6;
	    sigmaRelax *= 1.0 / (1.0 + _under * 0.4);
	}

	// [坐标空间修正] 本 pass 的 texelPos 是**画布**坐标（可能半分辨率）：
	//   · 视线方向要用画布 UV（`texelToUv` 是全分辨率像素尺寸，直接用会把 UV 压到左上 1/4）；
	//   · 几何法线要从**屏幕**纹素取（按本帧棋盘相位映射），画布坐标直接传给 Fetch* 会读错像素。
	vec2 centerCanvasUvForDir = (vec2(texelPos) + 0.5) / vec2(canvasEnd);
	vec3 viewDir = ScreenToViewDirRaw(centerCanvasUvForDir);
#ifdef VXGI_FULLRES
	ivec2 centerScreenTexel = texelPos;
#else
	ivec2 centerScreenTexel = texelPos * 2 + checkerboardOffset2x2[frameCounter & 3u];
#endif
	vec3 geoNormal = mat3(gbufferModelView) * FetchGeometryNormal(centerScreenTexel);

	float NdotV = abs(dot(geoNormal, viewDir));
	// 各向异性滤波步长：随 pass 指数递增（1,2,4,8…）
	vec2 offsetScaleBase = oms(abs(geoNormal.xy) * oms(NdotV)) * ldexp(2.0, FILTER_PASS_INDEX);
	// [2026-08-19 NRD] hit-distance 自适应模糊半径：
	// 目标是世界空间恒定滤波半径 → 像素步长 = NRD_RADIUS(m) × (深度1处每世界单位像素) / 视距。
	// 近处(视距小)需更多像素才覆盖目标半径 → 步长放大；远处步长收窄，防远处过糊。
	// gbufferProjection[1][1]=1/tan(fovY/2)，深度1处每世界单位像素 = halfViewSize.y / tanHalfFovY。
	// NRD_RADIUS=0 → 保持原固定像素步长（不启用）。clamp 防近处爆步长 / 远处趋零。
	float viewDist = max(-float(normalDepthData.z), 0.25);
	float pxPerWorldAtZ1 = canvasHeight * gbufferProjection[1][1];
	float depthFactor = NRD_RADIUS <= 0.0 ? 1.0
	                    : clamp(NRD_RADIUS * pxPerWorldAtZ1 / viewDist, 0.5, 1.5);
	vec2 offsetScale = offsetScaleBase * depthFactor * stepBoost;
	// 每轴步长至少 1 px：掠射面上 offsetScaleBase 会被压到 <0.5（例：斜墙 n≈(0.9,0.1) 时
	// x 轴只剩 0.1），round() 后该轴整列 tap 全部塌到中心 ⇒ 9-tap 退化成 1D 竖/横条，
	// 屏幕上表现为随朝向变化的条纹/纹路。下限 1 px 保住 2D 核。
	offsetScale = max(offsetScale, vec2(1.0));
	// 抖动与大步长解耦：NRD 开启时 offsetScale 会被放大，若采样抖动也随 offsetScale
	// 放大，每帧采样起始点会大跳 → 点状闪烁。故开启时抖动限制在 ≤1 像素。
	float jitterSize = NRD_RADIUS <= 0.0 ? max(depthFactor, 1.0) : 1.0;


	// float variance = CalculateVariance(ivec2(localPos + padRadius));
	float16_t variance = filteredColVar.a;
	// [2026-08-09 同步官方 SVGF] 亮度/法线方差权重：随方差与历史因子缩放
	// [2026-08-19 NRD] 去遮挡：不可靠像素乘 sigmaRelax 降低边缘保持，多吸收周围样本
	float16_t sigmaL = float16_t(-0.5 * inversesqrt(variance + EPS) * historyFactor) * float16_t(sigmaRelax);

	f16vec3 centerNormal = f16vec3(OctDecodeSnorm(normalDepthData.xy));

	// [⑤ 官方几何/法线拒判]
	// `planeDistanceSensitivity = 0.02`：tap 到"中心像素切平面"的归一化偏离上限；
	// `lobeAngleFraction = 0.15`：漫反射瓣角（90°）的 15% ≈ 13.5°，即法线夹角上限。
	const float PLANE_DIST_SENS = 0.02;
	const float LOBE_FRACTION = 0.15;
	const float LOBE_COS = 0.9723699;   // cos(0.15 * 90°)
	// 注意：本 pass 工作在**画布空间**（可能半分辨率），`texelToUv` 用的是全分辨率像素尺寸，
	// 直接用会把 UV 压到左上角四分之一 ⇒ NDC 错误 ⇒ 切平面判据完全失效。
	vec2 centerCanvasUv = (vec2(texelPos) + 0.5) / vec2(canvasEnd);
	vec3 centerViewPos = ScreenToViewPosRaw(centerCanvasUv, normalDepthData.z);
	// [关键修正] 切平面距离必须用**视空间**法线：`centerNormal` 来自 colortex14，是**世界空间**方向，
	// 而 centerViewPos / tapViewPos 是视空间位置。世界法线 × 视空间差向量 = 垃圾值
	// ⇒ planeDist 几乎总超出 0.02 容差 ⇒ 所有 tap 被拒 ⇒ 滤波退化成"只用中心"
	// ⇒ 整屏 1spp 小点（实测："整个世界都是劈里啪啦的小点，静止也一样"）。
	vec3 centerN = mat3(gbufferModelView) * vec3(centerNormal);

	float16_t sumWeight = float16_t(1.0);
	// filteredColVar *= vec4(vec3(sumWeight), sumWeight * sumWeight);
	// [2026-11-08 去掉逐帧抖动] 原来这里把 `frameCounter` 传进 BlueNoise，即**每帧换一个
	// 滤波取样偏移**。后果：即使输入（累积结果）几乎不变，滤波 tap 的位置每帧在 ±0.5 px 内跳，
	// 输出就逐帧变化 ⇒ **静止也在闪**（实测：强制历史永远有效、alpha ≈ 0.01 的情况下仍然闪）。
	// 官方 NRD/SVGF 的 a-trous **核位置是固定的**：抖动只用于追踪采样，不用于滤波 tap。
	// 去掉 `frameCounter` 后偏移变成「每像素固定」，滤波输出对静态输入完全稳定。
	// 若需要打散图案，用既有的「滤波核逐帧旋转」(GI_KERNEL_ROT_PER_FRAME) 那个独立开关。
	vec2 sampleTexelBase = vec2(texelPos) + (BlueNoise(texelPos, FILTER_PASS_INDEX) - vec2(0.5)) * jitterSize;

	// 整核旋转：把 3x3 方形格点整体绕像素中心旋转，方形印记在统计上被抹平（NRD 用旋转 Poisson 盘
	// 是同一目的）。角度 = 每像素 hash + 每 pass 黄金角（≈137.5°，让四级方向均匀铺开，不再叠成四折十字）。
	// 默认「每像素固定」：静止时最干净，也不引入帧间噪声；但方向图案钉在屏幕上，相机一转世界内容在
	// 这套图案下滑动 ⇒ 滤波结果显得乱/不光滑。GI_KERNEL_ROT_PER_FRAME 打开后叠加逐帧旋转，
	// 由时域累积与 TAA 把这份空间不规则平均掉（代价：单帧略多噪声）。
	float _rotFrame = GI_ROT_PER_FRAME * float(frameCounter) * 2.39996323;
	float _tapAng = hash13(vec3(texelPos, float(FILTER_PASS_INDEX))) * 6.2831853
	              + float(FILTER_PASS_INDEX) * 2.39996323 + _rotFrame;
	mat2 _tapRot = mat2(cos(_tapAng), sin(_tapAng), -sin(_tapAng), cos(_tapAng));

	for (uint i = 0u; i < 9u; ++i) {
		ivec2 sampleTexel = ivec2(round(sampleTexelBase + _tapRot * (vec2(offset3x3[i]) * offsetScale)));
		if (clamp(sampleTexel, ivec2(1), canvasEnd - 2) == sampleTexel) {
			f16vec3 sampleAux = f16vec3(texelFetch(colortex14, sampleTexel, 0).rgb);

			f16vec4 sampleColVar = f16vec4(imageLoad(EAWF_SRC, sampleTexel));
			sampleColVar.rgb = min(sampleColVar.rgb, f16vec3(fireflyCeil));   // ⑦ firefly 抑制
			// 引导亮度取稳定化辐射（见 centerLuma 处说明）；数据仍用本帧滤波对象。
			// tap 的 guide 同样按该 tap 的累积帧数加权（新暴露 tap 用自身亮度，避免跨表面误拒）。
#if defined VOXEL_GI_NRD_ACTIVE
			float16_t sampleLuma;
			if ((GI_BISECT & 1) == 0) {
			    float _tapLen = texelFetch(colortex2, sampleTexel, 0).a;
			    float _tapTrust = saturate((_tapLen - 2.0) * 0.125);
			    sampleLuma = float16_t(mix(sampleColVar.r, float(texelFetch(colortex23, sampleTexel, 0).r), _tapTrust));
			} else sampleLuma = sampleColVar.r;
			if (sampleLuma <= 1e-6) sampleLuma = sampleColVar.r;
#else
			float16_t sampleLuma = sampleColVar.r;
#endif
			if (sampleLuma <= 1e-6) sampleLuma = sampleColVar.r;

			// [⑤] 几何拒判：tap 到中心切平面的归一化偏离（官方 planeDistanceSensitivity）
			vec2 tapCanvasUv = (vec2(sampleTexel) + 0.5) / vec2(canvasEnd);
			vec3 tapViewPos = ScreenToViewPosRaw(tapCanvasUv, sampleAux.z);
			float planeDist = abs(dot(tapViewPos - centerViewPos, centerN)) / max(abs(centerViewPos.z), 1e-3);
			// 容差下限：0.02 是相对视距的百分比，近距离折成绝对距离会极小 ⇒ 会误拒同表面 tap
			// （全拒 = 滤波退化 = 整屏 1spp 小点）。用「2 个世界单位/视距」做下限。
			float planeTol = max(PLANE_DIST_SENS, 2.0 * rcp(max(abs(centerViewPos.z), 1.0)));
			float16_t weight = float16_t(saturate(1.0 - planeDist * rcp(planeTol)));
			// [⑤] 法线拒判：夹角上限 = 瓣角 × lobeAngleFraction（官方 lobeAngleFraction）
			float _nd = dot(OctDecodeSnorm(sampleAux.xy), vec3(centerNormal));   // 世界·世界
			weight *= float16_t(smoothstep(LOBE_COS - 0.02, LOBE_COS + 0.02, _nd));
			// 亮度权重（self-guided，保留）
			float logWeightL = abs(sampleLuma - centerLuma) * sigmaL;
			weight *= float16_t(saturate(exp2(logWeightL)));
			// 径向权重（中心 0.25 / 边 0.125 / 角 0.0625，即文件里一直没被使用的 kernel[8] 那套核）：
			// 不加这一层，9-tap 是等权方形核，格子的方形几何会直接印到画面上。
			bool _centerTap = (offset3x3[i].x == 0 && offset3x3[i].y == 0);
			bool _edgeTap   = (offset3x3[i].x == 0 || offset3x3[i].y == 0);
			weight *= float16_t(_centerTap ? 4.0 : (_edgeTap ? 2.0 : 1.0));
			// ④ 命中距离权重（官方 minHitDistanceWeight）
#ifdef VOXEL_GI_NRD_ACTIVE
			weight *= float16_t(mix(MIN_HITDIST_WEIGHT, 1.0, saturate(texelFetch(colortex22, sampleTexel, 0).a)));
#endif

			filteredColVar += sampleColVar * f16vec4(f16vec3(weight), weight * weight);
			sumWeight += weight;
		}
	}

	// 方向性长采样：原来每个 pass 用固定屏幕方向（(1,1) / (1,-1) / (1,0) / (0,1)），四级叠加会在
	// 画面上留下十字/星形纹路。改成每像素、每 pass 一个随机方向——保留「单向长距离扩散」的收益，
	// 但不留统一方向可循。与整核旋转共用 _rotFrame：开启逐帧旋转时两者一起变，避免长采样方向
	// 仍钉在屏幕上而单独造成不规则。
	{
	    float _ang = hash13(vec3(texelPos, float(FILTER_PASS_INDEX + 1))) * 6.2831853 + _rotFrame;
	    vec2 _axis = vec2(cos(_ang), sin(_ang));
	    float _len = max(offsetScale.x, offsetScale.y);
	    for (int _d = 0; _d < 2; ++_d) {
	        ivec2 sampleTexel = texelPos + ivec2(round(_axis * _len * (_d == 0 ? 1.0 : -1.0)));
	        if (clamp(sampleTexel, ivec2(1), canvasEnd - 2) == sampleTexel) {
	            f16vec3 sampleAux = f16vec3(texelFetch(colortex14, sampleTexel, 0).rgb);
	            f16vec4 sampleColVar = f16vec4(imageLoad(EAWF_SRC, sampleTexel));
	            sampleColVar.rgb = min(sampleColVar.rgb, f16vec3(fireflyCeil));   // ⑦ firefly 抑制
#if defined VOXEL_GI_NRD_ACTIVE
	            float16_t sampleLuma;
	            if ((GI_BISECT & 1) == 0) {
	                float _tapLen = texelFetch(colortex2, sampleTexel, 0).a;
	                float _tapTrust = saturate((_tapLen - 2.0) * 0.125);
	                sampleLuma = float16_t(mix(sampleColVar.r, float(texelFetch(colortex23, sampleTexel, 0).r), _tapTrust));
	            } else sampleLuma = sampleColVar.r;
	            if (sampleLuma <= 1e-6) sampleLuma = sampleColVar.r;
#else
	            float16_t sampleLuma = sampleColVar.r;
#endif
	            if (sampleLuma <= 1e-6) sampleLuma = sampleColVar.r;
	            // [⑤] 官方几何/法线拒判（同 9-tap）
	            vec2 tapCanvasUv = (vec2(sampleTexel) + 0.5) / vec2(canvasEnd);
	            vec3 tapViewPos = ScreenToViewPosRaw(tapCanvasUv, sampleAux.z);
	            float planeDist = abs(dot(tapViewPos - centerViewPos, centerN)) / max(abs(centerViewPos.z), 1e-3);
	            float planeTol = max(PLANE_DIST_SENS, 2.0 * rcp(max(abs(centerViewPos.z), 1.0)));
	            float16_t weight = float16_t(saturate(1.0 - planeDist * rcp(planeTol)));
	            float _nd = dot(OctDecodeSnorm(sampleAux.xy), vec3(centerNormal));   // 世界·世界
	            weight *= float16_t(smoothstep(LOBE_COS - 0.02, LOBE_COS + 0.02, _nd));
	            float logWeightL = abs(sampleLuma - centerLuma) * sigmaL;
	            weight *= float16_t(saturate(exp2(logWeightL)));
	            // ④ 命中距离权重（官方 minHitDistanceWeight）
#ifdef VOXEL_GI_NRD_ACTIVE
	            weight *= float16_t(mix(MIN_HITDIST_WEIGHT, 1.0, saturate(texelFetch(colortex22, sampleTexel, 0).a)));
#endif
	            filteredColVar += sampleColVar * f16vec4(f16vec3(weight), weight * weight);
	            sumWeight += weight;
	        }
	    }
	}

	sumWeight = float16_t(1.0) / sumWeight;
	filteredColVar *= f16vec4(f16vec3(sumWeight), sumWeight * sumWeight);

	// [2026-08-28 项3 ，2026-09-02 修复色度脱节] 最后一级(FILTER_PASS_INDEX==3)的大半径
	// 滤波后，对上一 pass 结果(colorimg3)做 3×3 中值，剔高频孤点亮噪(firefly)。取按 Y 排序的
	// 中值样本整体颜色(Y/Cg/Co/方差)，保证亮度/色度自洽，避免极暗处出现饱和彩点。
	#ifdef VOXEL_GI_FIREFLY_MEDIAN
	if (FILTER_PASS_INDEX == 3) {
	    // [FIX 2026-09-02] 原实现只取 3×3 邻域的 Y(亮度)中位数值替换 filteredColVar.r，
	    // 色度 Cg/Co 仍是含亮火苗的加权均值。极暗区域里中位 Y≈0 而色度≠0 →
	    // YCoCg 亮度/色度脱节，解码回 RGB(R=Y+Cg+Co, G=Y-Cg, B=Y+Cg-Co) 时
	    // 产出过饱和彩点。改为按 Y 排序后取“中值样本的完整 vec4(Y/Cg/Co/方差)”，
	    // 整体取自真实像素，亮度与色度保持自洽。
	    float _ys[9];
	    ivec2 _ts[9];
	    int _oi[9];
	    {
	        int _k = 0;
	        for (int _dy = -1; _dy <= 1; ++_dy)
	        for (int _dx = -1; _dx <= 1; ++_dx) {
	            ivec2 _t = clamp(texelPos + ivec2(_dx, _dy), ivec2(0), canvasEnd - 1);
	            _ts[_k] = _t;
	            _ys[_k] = float(imageLoad(EAWF_SRC, _t).r);
	            _oi[_k] = _k;
	            ++_k;
	        }
	        // 按亮度 Y 升序对索引插入排序（3×3=9 元素，开销可忽略），索引 [4] = 中值
	        for (int _a = 1; _a < 9; ++_a) {
	            int _key = _oi[_a];
	            float _ky = _ys[_key];
	            int _b = _a - 1;
	            while (_b >= 0 && _ys[_oi[_b]] > _ky) {
	                _oi[_b + 1] = _oi[_b];
	                --_b;
	            }
	            _oi[_b + 1] = _key;
	        }
	    }
	    filteredColVar = f16vec4(imageLoad(EAWF_SRC, _ts[_oi[4]]));
	}
	#endif

	imageStore(EAWF_DST, texelPos, min(filteredColVar, FP16_MAX));
}
