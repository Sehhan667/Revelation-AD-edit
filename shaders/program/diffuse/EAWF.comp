//======// Main //================================================================================//
void main() {
	// SharedPreload();

	uvec2 localPos = QuadLayout8x8(gl_LocalInvocationIndex);
	ivec2 texelPos = ivec2(localPos + gl_WorkGroupID.xy * gl_WorkGroupSize.xy);

	// [FIX 2026-08-06] 光追降噪关闭（settings.glsl 注释 VOXEL_GI_DENOISE）时：
	// 透传 colortex3（保持棋盘信号，不做边缘保持滤波）。SSILVB 不受影响（非光追模式正常降噪）。
	#ifdef VOXEL_GI_ENABLED
		#ifndef VOXEL_GI_DENOISE
			imageStore(colorimg3, texelPos, imageLoad(colorimg3, texelPos));
			return;
		#endif
	#endif

	f16vec3 normalDepthData = f16vec3(texelFetch(colortex14, texelPos, 0).rgb);
	// vec2 depthGradient = vec2(dFdx(normalDepthData.w), dFdy(normalDepthData.w));

	// 0.0625 0.125 0.0625
	// 0.125  0.25  0.125
	// 0.0625 0.125 0.0625
	// 3×3 kernel used multiple times in the algorithm

	const float kernel[8] = {0.0625, 0.125, 0.0625, 0.125, 0.125, 0.0625, 0.125, 0.0625};

	f16vec4 filteredColVar = f16vec4(imageLoad(colorimg3, texelPos));
	float16_t centerLuma = filteredColVar.r; // We use YCoCg color space

	float frameIndex = texelFetch(colortex2, texelPos, 0).a;
	// [2026-08-09 同步官方 SVGF] 历史帧因子：帧数越多信任度越高
	float16_t historyFactor = float16_t(saturate(frameIndex * 0.1 - 0.125));

	vec3 viewDir  = ScreenToViewDirRaw(texelToUv(texelPos));
	vec3 geoNormal = mat3(gbufferModelView) * FetchGeometryNormal(texelPos);

	float NdotV = abs(dot(geoNormal, viewDir));
	// 各向异性滤波步长：随 pass 指数递增（1,2,4,8…）
	vec2 offsetScaleBase = oms(abs(geoNormal.xy) * oms(NdotV)) * ldexp(2.0, FILTER_PASS_INDEX);
	// [2026-08-19 NRD] hit-distance 自适应模糊半径：
	// 目标是世界空间恒定滤波半径 → 像素步长 = NRD_RADIUS(m) × (深度1处每世界单位像素) / 视距。
	// 近处(视距小)需更多像素才覆盖目标半径 → 步长放大；远处步长收窄，防远处过糊。
	// gbufferProjection[1][1]=1/tan(fovY/2)，深度1处每世界单位像素 = halfViewSize.y / tanHalfFovY。
	// NRD_RADIUS=0 → 保持原固定像素步长（不启用）。clamp 防近处爆步长 / 远处趋零。
	float viewDist = max(-float(normalDepthData.z), 0.25);
	float pxPerWorldAtZ1 = halfViewSize.y * gbufferProjection[1][1];
	float depthFactor = NRD_RADIUS <= 0.0 ? 1.0
	                    : clamp(NRD_RADIUS * pxPerWorldAtZ1 / viewDist, 0.5, 2.5);
	vec2 offsetScale = offsetScaleBase * depthFactor;
	// 抖动与大步长解耦：NRD 开启时 offsetScale 会被放大，若采样抖动也随 offsetScale
	// 放大，每帧采样起始点会大跳 → 点状闪烁。故开启时抖动限制在 ≤1 像素。
	float jitterSize = NRD_RADIUS <= 0.0 ? max(depthFactor, 1.0) : 1.0;

	float invThresholdZ = 8.0 / normalDepthData.z;

	// float variance = CalculateVariance(ivec2(localPos + padRadius));
	float16_t variance = filteredColVar.a;
	// [2026-08-09 同步官方 SVGF] 亮度/法线方差权重：随方差与历史因子缩放
	float16_t sigmaL = float16_t(-0.5 * inversesqrt(variance + EPS) * historyFactor);
	float16_t sigmaN = float16_t(32.0 * exp2(-0.5 * variance / sqr(centerLuma)) * historyFactor);

	f16vec3 centerNormal = f16vec3(OctDecodeSnorm(normalDepthData.xy));

	float16_t sumWeight = float16_t(1.0);
	// filteredColVar *= vec4(vec3(sumWeight), sumWeight * sumWeight);
	vec2 sampleTexelBase = vec2(texelPos) + (BlueNoise(texelPos, frameCounter + FILTER_PASS_INDEX) - vec2(0.5)) * jitterSize;

	for (uint i = 0u; i < 9u; ++i) {
		ivec2 sampleTexel = ivec2(round(sampleTexelBase + offset3x3[i] * offsetScale));
		if (clamp(sampleTexel, ivec2(1), ivec2(halfViewSize) - 2) == sampleTexel) {
			f16vec3 sampleAux = f16vec3(texelFetch(colortex14, sampleTexel, 0).rgb);

			f16vec4 sampleColVar = f16vec4(imageLoad(colorimg3, sampleTexel));
			float16_t sampleLuma = sampleColVar.r; // We use YCoCg color space

			// 深度权重：距离越远权重越低
			float16_t weight = float16_t(saturate(fma(abs(sampleAux.z - normalDepthData.z), invThresholdZ, 1.0)));
			// 法线权重 + 亮度权重
			float logWeightN = log2(saturate(dot(OctDecodeSnorm(sampleAux.xy), centerNormal))) * sigmaN;
			float logWeightL = abs(sampleLuma - centerLuma) * sigmaL;
			weight *= float16_t(saturate(exp2(logWeightN + logWeightL)));

			filteredColVar += sampleColVar * f16vec4(f16vec3(weight), weight * weight);
			sumWeight += weight;
		}
	}

	sumWeight = float16_t(1.0) / sumWeight;
	filteredColVar *= f16vec4(f16vec3(sumWeight), sumWeight * sumWeight);
	imageStore(colorimg3, texelPos, min(filteredColVar, FP16_MAX));
}
