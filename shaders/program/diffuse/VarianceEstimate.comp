//======// Input //===============================================================================//

layout (local_size_x = 16, local_size_y = 16) in;

//======// Utility //=============================================================================//

#include "/lib/Utility.glsl"

// 与 GI 画布同分辨率（默认半分辨率棋盘；VOXEL_GI_FULLRES 全分辨率）。须在 Utility 之后。
#ifdef VXGI_FULLRES
const vec2 workGroupsRender = vec2(1.0, 1.0);
#else
const vec2 workGroupsRender = vec2(0.5, 0.5);
#endif

//======// Uniform //=============================================================================//

writeonly restrict uniform image2D colorimg3;

#include "/lib/universal/Uniform.glsl"

//======// SSBO //================================================================================//

#include "/lib/universal/SSBO.glsl"

//======// Function //============================================================================//

const uint padRadius = 1;
const uvec2 sharedSize = gl_WorkGroupSize.xy + (padRadius << 1);

shared uint sharedMoments[sharedSize.y][sharedSize.x];

void SharedPreload() {
    ivec2 groupBase = ivec2(gl_WorkGroupID.xy * gl_WorkGroupSize.xy - padRadius);
    // GI 画布尺寸（半分辨率 = 屏幕一半；全分辨率 = 屏幕）
#ifdef VXGI_FULLRES
    ivec2 canvasEnd = ivec2(viewSize);
#else
    ivec2 canvasEnd = ivec2(halfViewSize);
#endif

    const uint sharedArea = sharedSize.x * sharedSize.y;
    const uint groupArea = gl_WorkGroupSize.x * gl_WorkGroupSize.y;
    const uint stageNum = (sharedArea - 1) / groupArea + 1;

    uint localIndex = gl_LocalInvocationIndex;
    ivec2 localID = ivec2(localIndex % sharedSize.x, localIndex / sharedSize.x);

    ivec2 loadTexel = groupBase + localID;
    loadTexel = clamp(loadTexel, ivec2(1), canvasEnd - 2);

    #ifdef VOXEL_GI_NRD_ACTIVE
    // 官方：方差由 prepass 的空间重用结果估出（本包 = colortex22）
    float luma = texelFetch(colortex22, loadTexel, 0).r;
#else
    float luma = texelFetch(colortex2, loadTexel, 0).r;
#endif
    sharedMoments[localID.y][localID.x] = packHalf2x16(vec2(luma, luma * luma));

    for (uint stage = 1u; stage < stageNum; ++stage) {
        localIndex = gl_LocalInvocationIndex + stage * groupArea;

        if (localIndex < sharedArea) {
            localID = ivec2(localIndex % sharedSize.x, localIndex / sharedSize.x);

            loadTexel = groupBase + localID;
            #ifdef VOXEL_GI_NRD_ACTIVE
    luma = texelFetch(colortex22, loadTexel, 0).r;
#else
    luma = texelFetch(colortex2, loadTexel, 0).r;
#endif
            sharedMoments[localID.y][localID.x] = packHalf2x16(vec2(luma, luma * luma));
        }
    }

    memoryBarrierShared();
    barrier();
}

//======// Main //================================================================================//
void main() {
    // NRD 路径不需要方差（EAWF 已改用几何/法线/命中距离/高斯四类权重，命中距离由
    // GIPrepass 单独做时域平滑）。这里只把 TA 的累积结果搬到 colortex3 供 EAWF 读取，
    // 省掉 shared preload 与 3x3 矩计算。
#ifdef VOXEL_GI_NRD_ACTIVE
    ivec2 texelPos = ivec2(gl_GlobalInvocationID.xy);
    #ifdef VXGI_FULLRES
        if (any(greaterThanEqual(texelPos, ivec2(viewSize)))) return;
    #else
        if (any(greaterThanEqual(texelPos, ivec2(halfViewSize)))) return;
    #endif
    vec4 _accum = texelFetch(colortex2, texelPos, 0);
    imageStore(colorimg3, texelPos, vec4(_accum.rgb, 0.0));
    return;
#endif

    SharedPreload();

    // [FIX 2026-08-06] 光追降噪关闭（settings.glsl 注释 VOXEL_GI_DENOISE）时：
    // 不写方差到 colortex3（保持棋盘信号）。
    #ifdef GI_ACTIVE_VXGI
        #ifndef VOXEL_GI_DENOISE
            return;
        #endif
    #endif

    uvec2 sharedTexel = gl_LocalInvocationID.xy + padRadius;
    vec2 moments = unpackHalf2x16(sharedMoments[sharedTexel.y][sharedTexel.x]);

    for (uint i = 0u; i < 8u; ++i) {
        ivec2 sampleOffset = offset3x3N[i];
        uvec2 sampleTexel = sharedTexel + sampleOffset;
        vec2 sampleMoments = unpackHalf2x16(sharedMoments[sampleTexel.y][sampleTexel.x]);
        moments += sampleMoments;
    }
    moments *= rcp(9.0);

    ivec2 texelPos = ivec2(gl_GlobalInvocationID.xy);
    vec4 integratedDiffuse = texelFetch(colortex2, texelPos, 0);

    // Vanilla lightmap blending（仅 SSILVB 信号需要；体素 GI 的原版 Lightmap 混合由
    // DeferredLight 按 VOXEL_GI_BLENDED_LIGHTMAP 处理，此处再混会重复叠加方块光）
    #ifndef GI_ACTIVE_VXGI
        float blocklight = Unpack2x8UX(loadMaterialPack(texelPos << 1).x);
        blocklight = pow5(blocklight) * exp2(-16.0 * integratedDiffuse.x * exposure.value);
        integratedDiffuse.rgb += RGBToYCoCg(blocklightColor) * saturate(blocklight) * SSILVB_BLENDED_LIGHTMAP;

        // [2026-08-09 同步官方 SVGF] 滤波前 tone-map 抑制 firefly
        integratedDiffuse.rgb *= rcp(1.0 + integratedDiffuse.x);
    #endif

    float _momVar = max0(moments.y - moments.x * moments.x);   // 原始方差，下面统一乘 16
#ifdef VOXEL_GI_NRD_ACTIVE
    // 官方：方差由 prepass 用空间重用样本的离散度估出（colortex24.r）。
    // 但若 prepass 因任何原因没写到值（或写 0），**绝不能**让方差为 0：
    //   sigmaL = -0.5/sqrt(variance) ⇒ 0 方差会让 |sigmaL| 爆炸 ⇒ 邻居全被拒 ⇒ 滤波空转。
    // 因此取两者的较大值作为下限保护。
    float _preVar = max(texelFetch(colortex24, texelPos, 0).r, 0.0);
    // 与 EAWF 侧原有量纲保持一致（SVGF 约定 ×16）；两个来源都乘同一个系数。
    float variance = 16.0 * max(_preVar, _momVar);
#else
    float variance = 16.0 * _momVar;
#endif

    imageStore(colorimg3, texelPos, vec4(integratedDiffuse.rgb, variance));
}
