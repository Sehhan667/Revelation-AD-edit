//======// Utility //=============================================================================//

#include "/lib/Utility.glsl"

//======// Input //===============================================================================//

layout(local_size_x = 16, local_size_y = 16) in;
const vec2 workGroupsRender = vec2(1.0, 1.0);

//======// Output //==============================================================================//

// [2026-09-21 B4] 原 Postfilter pass（composite6_b）合并进本 pass：colortex15 只剩
// Prepare 数据的只读消费，最终 DOF 结果直接写 colortex0，省一个全分辨率 compute
// dispatch 与 colortex15 一次全屏读 + colortex0 一次全屏写的往返。
layout(rgba16f) readonly restrict uniform image2D colorimg15;
writeonly restrict uniform image2D colorimg0;

//======// Uniform //==============================================================================//

#include "/lib/universal/Uniform.glsl"

//======// SSBO //================================================================================//

#define SSBO_DECLARED_TPYE restrict
#include "/lib/universal/SSBO.glsl"

//======// Shared Memory //=======================================================================//

// [2026-09-21 B4] 18x18 tile = workgroup 16x16 + 1 圈 pad，与原 Postfilter 相同的
// LDS 预算；pad 槽由 stageCount 循环分摊给全部线程（越界源坐标 clamp 到图像边缘）。
const uint padRadius = 1u;
const uvec2 sharedSize = gl_WorkGroupSize.xy + (padRadius << 1u);

shared vec4 sharedTile[sharedSize.y][sharedSize.x];
shared float sharedCoc[sharedSize.y][sharedSize.x];

//======// Function //============================================================================//

#include "/lib/universal/Random.glsl"

#include "/lib/universal/Transform.glsl"
#include "/lib/post/DOF.glsl"

struct DofGatherSample {
	vec3 color;
	float centerCoverage;
	float coveringCoverage;
	float coveringOpacity;
	float colorWeight;
};

vec4 DofLoadPoint(vec2 centerUv, vec2 sampleOffset) {
	vec2 sampleUv = centerUv + sampleOffset * viewPixelSize;
	sampleUv = DofMirrorUv(sampleUv);
	vec4 pointData = textureLod(colortex3, sampleUv, 0.0);
	return pointData;
}

DofGatherSample DofBuildGatherSample(
	vec2 centerUv,
	vec2 sampleOffset,
	float sampleDistance,
	float centerCoc,
	float centerCocRadius,
	float coveringCoc
) {
	vec4 sampleData = DofLoadPoint(centerUv, sampleOffset);
	float sampleCocRadius = abs(sampleData.a) * rcp(DOF_MAX_BLUR_RADIUS);
	float coveringBias = float(coveringCoc < 0.0);
	float coveringMembership = saturate(coveringCoc - sampleData.a + coveringBias);
	float coveringCoverage = DofApertureCoverage(
		sampleCocRadius, sampleDistance, DOF_MAX_BLUR_RADIUS
	) * coveringMembership;

	DofGatherSample gatherSample;
	gatherSample.color = sampleData.rgb;
	gatherSample.centerCoverage = DofApertureCoverage(
		centerCocRadius, sampleDistance, DOF_MAX_BLUR_RADIUS
	) * saturate(sampleData.a - centerCoc + 1.0) * (1.0 - coveringMembership);
	gatherSample.coveringCoverage = coveringCoverage;
	gatherSample.coveringOpacity = coveringCoverage;
	gatherSample.colorWeight = rcp(max(sqr(sampleData.a), 0.25));
	return gatherSample;
}

void DofAccumulateGatherSample(
	DofGatherSample gatherSample,
	inout vec3 centerLayerColor,
	inout float centerLayerWeight,
	inout vec3 coveringColor,
	inout float coveringWeight
) {
	float centerWeight = gatherSample.colorWeight * gatherSample.centerCoverage;
	float sampleCoveringWeight = gatherSample.colorWeight * gatherSample.coveringCoverage;
	centerLayerColor += gatherSample.color * centerWeight;
	centerLayerWeight += centerWeight;
	coveringColor += gatherSample.color * sampleCoveringWeight;
	coveringWeight += sampleCoveringWeight;
}

vec3 DofGatherDisk(
	vec2 centerUv,
	vec4 centerData,
	vec2 initialDir,
	float initialPhase,
	float radialPhase,
	float centerCoc,
	float coveringCoc,
	float gatherRadius
) {
	const float inverseSampleCount = rcp(float(DOF_GATHER_SAMPLES));
	radialPhase *= inverseSampleCount;

	float inverseMaxBlurRadius = rcp(DOF_MAX_BLUR_RADIUS);
	float gatherRadiusFraction = gatherRadius * inverseMaxBlurRadius;
	float centerCocRadius = abs(centerCoc) * inverseMaxBlurRadius;
	vec3 centerLayerColor = centerData.rgb * EPS;
	float centerLayerWeight = EPS;
	vec3 coveringColor = vec3(0.0);
	float coveringWeight = 0.0;
	float coveringOpacity = 0.0;
	vec2 direction = initialDir;
	float aperturePhase = initialPhase;
	#ifdef DOF_APERTURE_VIGNETTING
		vec3 vignettingData = DofApertureVignettingPrepare(centerUv);
	#endif

	for (uint pairIndex = 0u; pairIndex < uint(DOF_GATHER_SAMPLES >> 1); ++pairIndex) {
		uint firstIndex = pairIndex << 1u;
		float firstRadius = DofVogelRadius(firstIndex, radialPhase, inverseSampleCount);
		float secondRadius = DofVogelRadius(firstIndex + 1u, radialPhase, inverseSampleCount);
		vec2 firstOffset = DofApertureOffset(
			direction, aperturePhase, firstRadius * gatherRadius
		);
		vec2 secondOffset = DofApertureOffset(
			-direction, aperturePhase + 0.5, secondRadius * gatherRadius
		);
		#ifdef DOF_APERTURE_VIGNETTING
			DofApertureVignettingApply(firstOffset, gatherRadius, vignettingData);
			DofApertureVignettingApply(secondOffset, gatherRadius, vignettingData);
		#endif
		DofGatherSample firstSample = DofBuildGatherSample(
			centerUv, firstOffset, firstRadius * gatherRadiusFraction,
			centerCoc, centerCocRadius, coveringCoc
		);
		DofGatherSample secondSample = DofBuildGatherSample(
			centerUv, secondOffset, secondRadius * gatherRadiusFraction,
			centerCoc, centerCocRadius, coveringCoc
		);

		DofAccumulateGatherSample(
			firstSample, centerLayerColor, centerLayerWeight, coveringColor, coveringWeight
		);
		DofAccumulateGatherSample(
			secondSample, centerLayerColor, centerLayerWeight, coveringColor, coveringWeight
		);
		coveringOpacity += 2.0 * max(firstSample.coveringOpacity, secondSample.coveringOpacity);

		direction = DofRotatePair(direction);
		aperturePhase = fract(aperturePhase + dofPairPhase);
	}

	vec3 resolvedCenter = centerLayerColor / centerLayerWeight;
	vec3 resolvedCovering = coveringColor / maxEps(coveringWeight);
	coveringOpacity *= inverseSampleCount * float(coveringWeight > EPS);
	return mix(resolvedCenter, resolvedCovering, saturate(coveringOpacity));
}

vec4 DofFilter(ivec2 texelPos) {
	vec4 centerData = texelFetch(colortex3, texelPos, 0);
	float fogMask = texelFetch(colortex0, texelPos, 0).a;

	vec2 centerUv = texelToUv(texelPos);

	float centerCoc = centerData.a;
	vec2 kernelNoise = SampleStbnVec2(texelPos, frameCounter + 6);
	float jitterAngle = TAU * kernelNoise.x;
	vec2 initialDir = vec2(cos(jitterAngle), sin(jitterAngle));

	vec4 gatherData = imageLoad(colorimg15, texelPos);
	float gatherRadius = maxEps(gatherData.y);
	vec3 filteredColor = DofGatherDisk(
		centerUv, centerData, initialDir, kernelNoise.x, kernelNoise.y,
		centerCoc, gatherData.x, gatherRadius
	);
	return vec4(filteredColor, fogMask);
}

float DofResolveFocusViewDepth(ivec2 texelPos, float screenDepth) {
	#if defined LOD_MOD
		if (screenDepth > 1.0 - EPS) {
			return -ScreenToViewDepthLod(loadDepth1Lod(texelPos));
		}
	#endif

	return -ScreenToViewDepth(screenDepth);
}

float DofLoadFocusViewDepth(ivec2 texelPos) {
	#ifdef DOF_FOCUS_IGNORE_HAND
		float screenDepth = loadDepth2(texelPos);
	#else
		float screenDepth = loadDepth1(texelPos);

		if (screenDepth < 0.56) {
			screenDepth = screenDepth * rcp(MC_HAND_DEPTH) + (0.5 - 0.5 / MC_HAND_DEPTH);
		}
	#endif
	return DofResolveFocusViewDepth(texelPos, screenDepth);
}

float DofFindFocusTarget() {
	ivec2 imageEnd = ivec2(viewSize) - 1;
	ivec2 centerTexel = imageEnd >> 1;
	float closestDepth = FP16_MAX;

	for (int y = -2; y <= 2; ++y) {
		for (int x = -2; x <= 2; ++x) {
			ivec2 sampleTexel = clamp(centerTexel + ivec2(x, y) * 2, ivec2(0), imageEnd);
			closestDepth = min(closestDepth, DofLoadFocusViewDepth(sampleTexel));
		}
	}

	float depthBandwidth = rcp(max(0.25, closestDepth * 0.05));
	vec2 weightedDepth = vec2(0.0);
	for (int y = -2; y <= 2; ++y) {
		for (int x = -2; x <= 2; ++x) {
			ivec2 sampleTexel = clamp(centerTexel + ivec2(x, y) * 2, ivec2(0), imageEnd);
			float sampleDepth = DofLoadFocusViewDepth(sampleTexel);
			float depthDelta = (sampleDepth - closestDepth) * depthBandwidth;
			float spatialWeight = rcp(1.0 + 0.15 * sdot(vec2(x, y)));
			float weight = spatialWeight * rcp(1.0 + depthDelta * depthDelta);
			weightedDepth += vec2(sampleDepth, 1.0) * weight;
		}
	}

	return weightedDepth.x / maxEps(weightedDepth.y);
}

void DofUpdateFocus() {
	float targetDepth = DofFindFocusTarget();
	float previousDepth = global.dofFocusDistance;
	float blendWeight = exp2(-frameTime * rcp(DOF_FOCUS_HALFLIFE));
	global.dofFocusDistance = mix(targetDepth, previousDepth, saturate(blendWeight));
}

// [2026-09-21 B4] 以下三段自原 Postfilter.comp 平移，LDS 访问函数换名对齐本文件。
vec4 DofPostfilterLoad(uvec2 localTexel) {
	return sharedTile[localTexel.y][localTexel.x];
}

float DofPostfilterLoadCoc(uvec2 localTexel) {
	return sharedCoc[localTexel.y][localTexel.x];
}

void DofSort3(vec3 a, vec3 b, vec3 c, out vec3 low, out vec3 median, out vec3 high) {
	vec3 minBC = min(b, c);
	vec3 maxBC = max(b, c);
	low = min(a, minBC);
	median = min(max(a, minBC), maxBC);
	high = max(a, maxBC);
}

vec3 DofMedian3x3(uvec2 localCenter, float centerCoc) {
	bool centerForeground = centerCoc < 0.0;
	vec3 samples[9];
	samples[4] = DofPostfilterLoad(localCenter).rgb;

	for (uint i = 0u; i < 8u; ++i) {
		uvec2 sampleTexel = uvec2(ivec2(localCenter) + offset3x3N[i]);
		vec4 sampleData = DofPostfilterLoad(sampleTexel);
		float sampleCoc = DofPostfilterLoadCoc(sampleTexel);
		float sameLayer = float((sampleCoc < 0.0) == centerForeground);
		samples[i < 4u ? i : i + 1u] = mix(samples[4], sampleData.rgb, sameLayer);
	}

	vec3 low[3], median[3], high[3];
	for (uint row = 0u; row < 3u; ++row) {
		uint base = row * 3u;
		DofSort3(samples[base], samples[base + 1u], samples[base + 2u], low[row], median[row], high[row]);
	}

	vec3 lowMax = max(max(low[0], low[1]), low[2]);
	vec3 medianMid = min(max(median[0], min(median[1], median[2])), max(median[1], median[2]));
	vec3 highMin = min(min(high[0], high[1]), high[2]);
	vec3 resultLow, resultMedian, resultHigh;
	DofSort3(lowMax, medianMid, highMin, resultLow, resultMedian, resultHigh);
	return resultMedian;
}

//======// Main //================================================================================//
void main() {
	// [2026-09-21 B4] 越界线程不提前 return：LDS tile 必须填满（中值要读邻域），
	// 源坐标 clamp 到图像边缘即可；输出阶段再按 texelPos 边界剔除。
	ivec2 imageEnd = ivec2(viewSize) - 1;
	ivec2 groupBase = ivec2(gl_WorkGroupID.xy * gl_WorkGroupSize.xy) - ivec2(padRadius);

	const uint sharedArea = sharedSize.x * sharedSize.y;
	const uint groupArea = gl_WorkGroupSize.x * gl_WorkGroupSize.y;
	const uint stageCount = (sharedArea + groupArea - 1u) / groupArea;

	for (uint stage = 0u; stage < stageCount; ++stage) {
		uint loadIndex = gl_LocalInvocationIndex + stage * groupArea;
		if (loadIndex < sharedArea) {
			uvec2 localTexel = uvec2(loadIndex % sharedSize.x, loadIndex / sharedSize.x);
			ivec2 sourceTexel = clamp(groupBase + ivec2(localTexel), ivec2(0), imageEnd);
			sharedTile[localTexel.y][localTexel.x] = DofFilter(sourceTexel);
			sharedCoc[localTexel.y][localTexel.x] = texelFetch(colortex3, sourceTexel, 0).a;
		}
	}

	memoryBarrierShared();
	barrier();

	ivec2 texelPos = ivec2(gl_GlobalInvocationID.xy);
	if (any(greaterThanEqual(texelPos, ivec2(viewSize)))) return;

	uvec2 localCenter = gl_LocalInvocationID.xy + padRadius;
	vec4 centerData = DofPostfilterLoad(localCenter);
	vec3 medianColor = DofMedian3x3(localCenter, DofPostfilterLoadCoc(localCenter));
	imageStore(colorimg0, texelPos, vec4(medianColor, centerData.a));

	#if CAMERA_FOCUS_MODE == 0
		if (all(equal(texelPos, ivec2(0)))) {
			DofUpdateFocus();
		}
	#endif
}
