//======// Input //===============================================================================//

layout (local_size_x = 16, local_size_y = 16) in;
const vec2 workGroupsRender = vec2(0.5, 0.5);

//======// Utility //=============================================================================//

#include "/lib/Utility.glsl"

//======// Uniform //=============================================================================//

writeonly restrict uniform image2D colorimg3;
#ifdef VOXEL_REUSE
    // ReSTIR reservoir 乒乓（image.reservoirA/B，imageLoad/imageStore，RGBA16F 半分辨率）
    layout (rgba16f) restrict uniform image2D reservoirA;
    layout (rgba16f) restrict uniform image2D reservoirB;
    // reservoirW 存"当前像素的绝对世界坐标"作为一致性基准。
    // 必须用绝对世界坐标（固定基准）而非 view 空间坐标：view 空间跟相机走，
    // 相机平移时同方向像素的 viewPos 几乎不变 → 检测不出平移 → 平移不重置 → 拖影。
    // 绝对世界坐标数值范围大，RGBA16F 在远距离精度不足 → 用 RGBA32F。
    layout (rgba32f) restrict uniform image2D reservoirW;
    // 全局相机运动跟踪器（见 shaders.properties image.camTracker）
    layout (rgba32f) restrict uniform image2D camTracker;
#endif

#include "/lib/universal/Uniform.glsl"

#ifdef VOXEL_REUSE
// ReSTIR 上帧乒乓 reservoir（按帧奇偶选 buffer）
vec4 PingReusePrev(ivec2 p) {
    return ((frameCounter & 1u) == 0u) ? imageLoad(reservoirB, p) : imageLoad(reservoirA, p);
}
#endif

//======// SSBO //================================================================================//

#include "/lib/universal/SSBO.glsl"

//======// Function //============================================================================//

#include "/lib/universal/Transform.glsl"
#include "/lib/universal/Fetch.glsl"
#include "/lib/universal/Random.glsl"

#include "/lib/atmosphere/Common.glsl"

#include "/lib/surface/BRDF.glsl"
#include "/lib/lighting/SSILVB.glsl"

//======// 追踪 SPP //==============================================================================//
// [2026-08-19] 离线模式每像素漫反射追踪光线数（同帧多射线平均，降低棋盘时域依赖，更快更干净）。
// 仅 OFFLINE_RENDER 时生效；实时模式仍为棋盘 1 SPP。
#ifndef VOXEL_TRACE_OFFLINE_SPP
    #define VOXEL_TRACE_OFFLINE_SPP 20
#endif
// [2026-08-21] 实时模式每像素每帧漫反射追踪光线数（SPP）。默认 1 = 现状（棋盘半分辨率 + 时域累积）；
// 调大同帧多射线平均 → 单帧更干净、时域收敛更快，但性能按比例下降（每射线一次 DDA 步进）。
// 与 OFFLINE_RENDER 的 VOXEL_TRACE_OFFLINE_SPP 独立：实时用本宏，离线用离线宏。
#ifndef VOXEL_TRACE_SPP
    #define VOXEL_TRACE_SPP 1 // [1 2 4 8 16 32 64]
#endif

#ifdef PROBE_GI_ENABLED
    // 探针 GI 信号源：16³ 平滑探针缓存 trilinear 查询（独立于 VXGI/SSILVB，见 lib/lighting/ProbeGI.glsl）
    #include "/lib/lighting/shadow/Common.glsl"
    uniform sampler2DShadow shadowtex1;
    uniform sampler2D atlas2D;   // VoxelData.glsl 的 VoxelGetAtlasCoord 引用 textureSize(atlas2D)
    uniform sampler3D voxelDataSampler;
    uniform usampler3D voxelLightSampler;
    #include "/lib/lighting/VoxelData.glsl"
    #include "/lib/lighting/VoxelSunShadow.glsl"
    #include "/lib/lighting/VoxelSkyLight.glsl"
    #include "/lib/lighting/ProbeGI.glsl"

    // [Plan B 2026-09-03] 写端并入本 compute dispatch：乒乓写 B 读 A（不同纹理，同 dispatch 无冲突），
    // 彻底摆脱"额外写端 pass 是否被调度"的不确定性（fragment 写端在 deferred50 与 deferred22 均已证伪）。
    // 写端 image 端与查询端 sampler 端经 shaders.properties image.probeRadiance 指向同一份 16³ 纹理。
    layout (rgba16f) restrict writeonly uniform image3D probeRadiance;
    layout (rgba16f) restrict writeonly uniform image3D probeRadiance2;

    //============================================================================================//
    // ProbeTrace — 探针采样线（DDGI 风格，一阶弹射）
    // 从探针格心（体素空间连续坐标）沿方向 DDA 穿 voxelData 场景：
    // - 发射光体素 → 球形光源平滑贡献 + 穿透不挡光（VoxelHitLightSphere）
    // - 首实心命中 → 返回该面辐射度：方块光 + 阳光反弹(VoxelSunShadow 遮挡) + 天光底
    // - 出界/射程尽 → 返回方向天光（VoxelSkyColor）
    // 与 VoxelTracing 的差异：探针各向同性 → 无半球权重、无 IRC 自反弹（一阶弹射）。
    // 值 = 入射辐照度（后在 DeferredLight 乘 albedo）。DDA 复用 rdir 有符号修正等修复。
    // compute 安全：不用 VoxelSkyColor（其采大气 LUT，compute 未绑定 → NaN），改用 skyColor
    // × 地平线衰减；阳光只用体素 DDA（VoxelSunShadowTracing）+ SSBO global.directIlluminance。
    //============================================================================================//
    vec3 ProbeTrace(vec3 origin, vec3 dir) {
        vec3 voxelCoord = floor(origin);
        vec3 sdir = sign(dir);
        vec3 rdir = 1.0 / mix(dir, vec3(1e-30), lessThanEqual(abs(dir), vec3(1e-8)));
        vec3 totalStep = (sdir * (voxelCoord - origin + 0.5) + 0.5) * abs(rdir);
        vec3 contrib = vec3(0.0);
        vec3 tracingNext = step(totalStep, vec3(VoxelMin3(totalStep)));

        for (int i = 0; i < VOXEL_TRACE_DISTANCE; ++i) {
            float rayLength = 0.0;
            if (i > 0) {
                rayLength = VoxelMin3(totalStep);
                if (rayLength > float(VOXEL_TRACE_DISTANCE)) break;
                tracingNext = step(totalStep, vec3(rayLength));
                voxelCoord += tracingNext * sdir;
                totalStep += tracingNext * abs(rdir);
                if (any(lessThan(voxelCoord, vec3(0.0))) || any(greaterThanEqual(voxelCoord, vec3(float(VOXEL_AREA))))) break;
            }

            ivec3 vc = ivec3(voxelCoord);
            vec4 hvd = texelFetch(voxelDataSampler, vc, 0);
            if (hvd.z <= 0.5) continue;

            vec3 lD = unpackUnorm4x8(texelFetch(voxelLightSampler, vc, 0).r).rgb;
            if (lD.z > VOXEL_GI_EMISSIVE_THRESHOLD) {
                contrib += VoxelHitLightSphere(origin, dir, vec3(vc), VoxelLightColor(abs(hvd.z)));
                continue;
            }

            if (i == 0 && abs(hvd.z) <= 154.0) continue;

            VoxelRay vray;
            vray.ori = origin; vray.dir = dir; vray.rdir = rdir; vray.sdir = sdir;
            vec3 hitNormal;
            if (!IsHitBlock(vray, totalStep, tracingNext, voxelCoord, abs(hvd.z), rayLength, hitNormal)) continue;
            if (i == 0) rayLength = max(rayLength, 0.0);

            vec3 alb = vec3(hvd.r, hvd.g, VoxelUnpack2xU8X(hvd.w));
            vec3 v = vec3(0.0);

            if (lD.y > 0.01)
                v += max(alb, vec3(VOXEL_GI_BLOCK_MIN_ALBEDO)) * VoxelLightColor(abs(hvd.z)) * lD.y * VOXEL_GI_BLOCK_STRENGTH;

            if (worldId != -1) {
                vec3 sunDir = mat3(shadowModelViewInverse) * vec3(0.0, 0.0, 1.0);
                float NdotL = saturate(dot(sunDir, hitNormal));
                vec3 hitVoxelPos = origin + dir * rayLength;
                vec3 sunVis = vec3(VoxelSunShadowTracing(hitVoxelPos, sunDir));
                vec3 directIllum = sunIrradiance;
                if (max(max(global.directIlluminance.r, global.directIlluminance.g), global.directIlluminance.b) > 1e-4)
                    directIllum = global.directIlluminance * rcp(VOXEL_SUN_REFERENCE);
                v += alb * directIllum * NdotL * sunVis;
            }

            vec3 shadowlight = sunIrradiance * rcp(max(luminance(sunIrradiance), 1e-4));
            v += alb * SimpleSkyLighting(skyColor, shadowlight, hitNormal.y, 0.5);
            return v;
        }

        if (worldId != -1) {
            float fade = VoxelSkyHorizonFade(dir);
            if (fade > 0.001) return max(skyColor * fade, vec3(0.0));
        }
        return contrib;
    }

    // ProbeUpdateSlice：本 invocation 分摊更新若干探针（16³ 展平 [0,4096)，按 texelPos 分摊）。
    // 网格只有 4096 格 × PROBE_RAY_SAMPLES 条线/帧，全量更新开销可控；EMA 时域累积 + 历史重投影。
    void ProbeUpdateSlice(ivec2 pix) {
        int totalVoxels = PROBE_GI_GRID_SIZE * PROBE_GI_GRID_SIZE * PROBE_GI_GRID_SIZE;
        // viewWidth/viewHeight 是 float（Uniform.glsl）；须先转 int 再右移（>> 只接受整型操作数）。
        int totalPixels = max((int(viewWidth) >> 1) * (int(viewHeight) >> 1), 1);
        int perPixel = max((totalVoxels + totalPixels - 1) / totalPixels, 1);
        int pixIdx = pix.y * (int(viewWidth) >> 1) + pix.x;
        int ia = min(pixIdx * perPixel, totalVoxels);
        int ib = min(ia + perPixel, totalVoxels);

        // ---- DDGI 式网格重居中 ----
        // 探针网格世界锚定：探针(0,0,0)的世界坐标 gridOrigin，对齐到 4m 整数探针格边界。
        // 相机始终位于网格中心附近；相机跨过 4m 边界时网格整格平移，内容按整数格重投影。
        const float GRID_HALF = float(PROBE_GI_GRID_SIZE) * 0.5;
        vec3 gridOriginThis = (round(cameraPosition * rcp(PROBE_SPACING)) - GRID_HALF) * PROBE_SPACING;
        vec3 gridOriginPrev = (round(previousCameraPosition * rcp(PROBE_SPACING)) - GRID_HALF) * PROBE_SPACING;
        vec3 reCenter = (gridOriginThis - gridOriginPrev) * rcp(PROBE_SPACING);   // 整数格重居中偏移

        for (int vi = ia; vi < ib; ++vi) {
            int G = PROBE_GI_GRID_SIZE;
            int z = vi / (G * G);
            int y = (vi / G) % G;
            int x = vi % G;
            ivec3 tid = ivec3(x, y, z);

            // 探针 tid 的世界位置(4m 格心) → 体素坐标(vc)采样体素化（世界锚定）
            vec3 probeCenter = (gridOriginThis + (vec3(tid) + 0.5) * PROBE_SPACING)
                             - vec3(cameraPositionInt) + float(VOXEL_RADIUS);

            vec3 acc = vec3(0.0);
            for (int s = 0; s < PROBE_RAY_SAMPLES; ++s) {
                // 方向采样用纯函数 hash13（Random.glsl，无纹理/无 LUT 依赖）。STBN 蓝噪声在
                // deferred compute 可能未绑定 → texelFetch 返 0 → 所有线方向恒同一 → GI 歪。
                vec2 u = vec2(hash13(vec3(tid.x, tid.y, tid.z) * 7.13 + vec3(s * 1.7, s * 2.3, float(frameCounter))),
                              hash13(vec3(tid.x, tid.y, tid.z) * 11.7 + vec3(s * 3.1, s * 4.7, float(frameCounter) * 1.3)));
                vec3 dir = VoxelSphereUnitVectorFromU(u);
                // [FIX 2026-09-03 NaN 防护] 单条线若有 NaN/负值（DDA/求交/未绑定采样器兜底路径），
                // 会把整个探针平均污染成 NaN → EMA oldValid=false(no temporal) → 缓存闪烁；
                // 且 NaN 经 trilinear 读取传播成"忽明忽暗/移动时一闪一闪"。逐样本守卫：坏样本置 0。
                vec3 _samp = ProbeTrace(probeCenter, dir);
                if (!all(equal(_samp, _samp)) || any(lessThan(_samp, vec3(0.0)))) _samp = vec3(0.0);
                acc += _samp;
            }
            vec3 newVal = acc * rcp(float(PROBE_RAY_SAMPLES));
            // 钳到 [0, 8) 并与 oldValid 的 <8 判据一致，避免大值触发 mixA=1.0（跳过 EMA → 闪）。
            newVal = clamp(newVal, vec3(0.0), vec3(7.9));

#ifdef DEBUG_PROBE_PLUMBING
            // [管线自检] 写端健康标记：世界锚定、16m 周期渐变色（与查询端直算参考同公式
            // fract((vc+camInt)/16)），写入探针格心世界坐标。重载后左半若显示与右半近似的
            // 彩色渐变并钉在世界 → 写读链路通；仍一片亮红 → 写端没写。
            vec3 _probeCenterWorld = probeCenter + vec3(cameraPositionInt);
            newVal = fract(_probeCenterWorld * rcp(16.0));
#else
#endif

            // EMA 历史读取 + DDGI 重居中：读上帧网格里该世界点的旧索引(= tid+0.5+reCenter)。
            // 整数格重投影(无插值)；越界(相机新暴露区域) → 历史无效 → 重置为新值。
            vec3 oldProbeCoord = vec3(tid) + 0.5 + reCenter;
            bool oldInBounds = all(greaterThanEqual(oldProbeCoord, vec3(0.0)))
                            && all(lessThan(oldProbeCoord, vec3(float(PROBE_GI_GRID_SIZE))));

            vec4 old = ((frameCounter & 1u) == 0u)
                ? ProbeFetchTrilinear(probeRadiance2Sampler, oldProbeCoord)
                : ProbeFetchTrilinear(probeRadianceSampler,  oldProbeCoord);

            bool oldValid = oldInBounds
                         && abs(old.a - 1.0) < 0.25
                         && all(equal(old.rgb, old.rgb))
                         && all(lessThan(old.rgb, vec3(8.0)))
                         && all(greaterThanEqual(old.rgb, vec3(0.0)));

            float mixA = oldValid ? 0.1 : 1.0;
#ifdef DEBUG_PROBE_PLUMBING
            mixA = 1.0;
#endif
            // [FIX 2026-09-03 移动重锚] 相机跨整数格边界(camInt 变)时,coarse 4m 格的重投影
            // 不精确 + 慢 EMA 会让内容缓慢重新锚定 → 移动时内容落后于世界 → "错位/乱飞"、
            // 停下才追回(正是调试渐变看到的 EMA 滞后)。移动期间提高 mixA 让内容快速对齐
            // 新位置(代价:移动时接受更多新值、略增噪声);完全静止仍用 0.1 做时域降噪。
            if (any(notEqual(cameraPositionInt, previousCameraPositionInt))) mixA = max(mixA, 0.5);
            vec3 oldVal = oldValid ? old.rgb : vec3(0.0);
            vec4 outVal = vec4(mix(oldVal, newVal, mixA), 1.0);
            if ((frameCounter & 1u) == 0u) imageStore(probeRadiance,  tid, outVal);
            else                            imageStore(probeRadiance2, tid, outVal);
        }
    }
#endif
// [管线自检 2 引用锚点] Iris GUI 布尔开关显示条件：必须单独一行 #ifdef。
#ifdef DEBUG_PROBE_QUERY
#endif
#ifdef VOXEL_GI_ENABLED
    // 体素 GI 信号源（阶段④：与 SSILVB 互斥，体素优先）：
    // IRC 采样器/查询 + 每像素漫反射追踪（VoxelTracing 内含 VoxelData/VoxelShape）
    #include "/lib/lighting/VoxelGI.glsl"
    // 方块图集（shaders.properties customTexture.atlas2D = blocks.png，与传播端同图集；
    // 无显式 binding：Iris 按名字自动绑定）
    uniform sampler2D atlas2D;
    // [FIX 2026-08-06] 追踪端阳光反弹的阴影判定依赖（sunVis，与注入端 VoxelGI.frag 一致）：
    // DistortShadowSpace 来自 shadow/Common.glsl；shadowtex1 按名绑定。此前追踪端阳光只靠
    // skylight 门控（×444 阈值极低）→ 地下/背阴有微弱 sky 残留就 8.0 倍阳光反弹 → 到处亮。
    #include "/lib/lighting/shadow/Common.glsl"
    uniform sampler2DShadow shadowtex1;
    #include "/lib/lighting/VoxelTracing.glsl"
#endif

float GetClosestDepthN(in ivec2 texel) {
    float depth = 1.0;

    for (uint i = 0u; i < 8u; ++i) {
        ivec2 sampleTexel = offset3x3N[i] + texel;
        float sampleDepth = loadDepth0(sampleTexel);
        depth = min(depth, sampleDepth);
    }

    return depth;
}

//======// Main //================================================================================//
void main() {
    uvec2 localPos = QuadLayout16x16(gl_LocalInvocationIndex);
    ivec2 texelPos = ivec2(localPos + gl_WorkGroupID.xy * gl_WorkGroupSize.xy);

#ifdef PROBE_GI_ENABLED
    // [Plan B] 同一 dispatch 内先更新缓存（写 B 读 A 乒乓），再执行查询（读另一块 = 上帧值）。
    // 放最前，无视地形/早期 return，保证 4096 探针每帧全量覆盖；写 B 读 A（不同纹理），无同 dispatch 读写冲突。
    ProbeUpdateSlice(texelPos);
#endif

    ivec2 renderTexel = texelPos * 2 + checkerboardOffset2x2[frameCounter & 3u];
	float depth = loadDepth0(renderTexel);
	bool terrainCheck = min(GetClosestDepthN(renderTexel), depth) < 1.0;
	#if defined LOD_MOD
        bool lodMask = !terrainCheck;
		if (lodMask) {
			depth = loadDepth0Lod(renderTexel);
			terrainCheck = depth < 1.0;
		}
	#endif

	#ifdef VOXEL_REUSE
	// ---- [2026-09-01] 全局相机运动判定 ----
	// per-pixel 几何门控（绝对世界坐标）对"棋盘半分辨率、每帧换角落"极易误判：
	// 阈值一靠边就逐像素随机 复用/重置 → 既是拖影又是跳变的来源。改为按"全局相机是否运动"一票否决：
	// 相机平移或转动 → 本帧全体不复用/不合并，一律重追踪；完全静止才允许复用。
	// camTracker 存上帧 viewInverse 旋转列 + 相机世界位；thread(0,0) 每帧写入当前值，其余线程读上帧值。
	vec4 _ct0 = imageLoad(camTracker, ivec2(0, 0));
	vec4 _ct1 = imageLoad(camTracker, ivec2(1, 0));
	vec4 _ct2 = imageLoad(camTracker, ivec2(2, 0));
	vec4 _ct3 = imageLoad(camTracker, ivec2(3, 0));
	mat3 _mvi = mat3(gbufferModelViewInverse);
	bool _camMoved = length(_ct3.xyz - cameraPosition) > 0.01;
	_camMoved = _camMoved
	         || any(greaterThan(abs(_ct0.xyz - _mvi[0]), vec3(1e-4)))
	         || any(greaterThan(abs(_ct1.xyz - _mvi[1]), vec3(1e-4)))
	         || any(greaterThan(abs(_ct2.xyz - _mvi[2]), vec3(1e-4)));
	if (gl_GlobalInvocationID.x == 0u && gl_GlobalInvocationID.y == 0u) {
		imageStore(camTracker, ivec2(0, 0), vec4(_mvi[0], 0.0));
		imageStore(camTracker, ivec2(1, 0), vec4(_mvi[1], 0.0));
		imageStore(camTracker, ivec2(2, 0), vec4(_mvi[2], 0.0));
		imageStore(camTracker, ivec2(3, 0), vec4(cameraPosition, 0.0));
	}
	#endif

	#if defined PROBE_GI_ENABLED && defined DEBUG_PROBE_QUERY
	// [管线自检 2026-09-03 v3] 全屏 A/B 对照，不 gate 在 terrainCheck 上：
	// 旧版把对照嵌在 if(terrainCheck) 内 → 天空/远景(depth≥1)像素直接 imageStore 0，
	// 视野一旦有大片天空就"半边完全没有图案"，误判为写端/读取挂了。
	// 这里提前整屏执行：左半=cacheCol 读回，右半=refCol 直算，两半都无视地形门控。
	// 判读：左半一片亮红 → deferred50 写端没在写缓存；左半与右半近似渐变 → 写端正常。
	{
		vec2 _sUv = texelToUv(renderTexel);
		vec3 _vPos = ScreenToViewPos(vec3(_sUv, depth));
		vec3 _pvcD = mat3(gbufferModelViewInverse) * _vPos + cameraPositionFract + float(VOXEL_RADIUS);
		#ifdef DEBUG_PROBE_PLUMBING
			vec3 _cacheD = ProbeSampleRadiance(_pvcD);
			vec3 _refD = fract((_pvcD + vec3(cameraPositionInt)) * rcp(16.0));
			vec3 _colD = (renderTexel.x < (int(viewWidth) >> 1)) ? _cacheD : _refD;
			imageStore(colorimg3, texelPos, vec4(RGBToYCoCg(_colD), 1.0));
		#else
			imageStore(colorimg3, texelPos, vec4(RGBToYCoCg(fract((_pvcD + vec3(cameraPositionInt)) * rcp(16.0))), 1.0));
		#endif
	}
	return;
	#endif

	if (terrainCheck) {
		#if defined LOD_MOD
			if (lodMask) depth = ViewToScreenDepth(ScreenToViewDepthLod(depth));
		#endif

    	vec2 screenCoord = texelToUv(renderTexel);
		vec3 viewPos = ScreenToViewPos(vec3(screenCoord, depth));
		// 绝对世界坐标（固定基准）——ReSTIR 几何一致性比较用它，不用 view 空间坐标：
		// view 坐标跟相机走，相机平移时该像素的 viewPos 几乎不变 → 检测不出平移 → 平移不重置 → 拖影。
		// gbufferModelViewInverse 第4列 = 相机世界位置，乘 vec4(viewPos,1) 即得像素击中的绝对世界点。
		vec3 _wpos = (gbufferModelViewInverse * vec4(viewPos, 1.0)).xyz;

		vec4 result;
		#ifdef PROBE_GI_ENABLED
			// 探针 GI：16³ 平滑缓存 trilinear 查询 → 入射辐照度（此后在 DeferredLight 乘 albedo）。
			// 无棋盘 SPP、免 SVGF 降噪（PROBE 时 VOXEL_GI 关，deferred4-9 不 dispatch）。
			vec3 _pvc = mat3(gbufferModelViewInverse) * viewPos + cameraPositionFract + float(VOXEL_RADIUS);
			#ifdef DEBUG_PROBE_QUERY
			// [管线自检 3] A/B 同屏对照（需同时开 DEBUG_PROBE_PLUMBING）：
			//   左半屏 = ProbeSampleRadiance(_pvc) 探针缓存读回（被测对象：fragment 写端 v2）
			//   右半屏 = 直算参考 fract((_pvc+camInt)/16)（当前帧由深度重算、钉世界已证正确，基准）
			// 两半应逐像素一致且同步钉世界。判读：
			//   左半闪回/拖影、右半钉死 → 写端 imageStore→sampler 链路问题（迁移 fragment 后应消失）
			//   左半相对右半整体滞后/平移 → 缓存锚滞后或 cDi 补偿错（查时序）
			//   左半左右闪跳 → 乒乓相位错（偶读B/奇读A 与写端偶写A/奇写B 失配）
			//   两半重合稳定 → 缓存读回正确，根源转向真实 GI 值本身
			// 注意只赋 RGB 原始值，勿预转 YCoCg——main 尾部统一转一次。
			vec3 _refCol = fract((_pvc + vec3(cameraPositionInt)) * rcp(16.0));
			#ifdef DEBUG_PROBE_PLUMBING
				vec3 _cacheCol = ProbeSampleRadiance(_pvc);
				// [FIX 2026-09-03] 分屏阈值必须用**全分辨率** renderTexel 坐标判定：
				// texelPos 是半分辨率（范围 [0, viewWidth/2)），旧式 texelPos.x < viewWidth/2
				// 恒真 → 全屏都走缓存侧，右半屏直算参照永不显示。renderTexel 才是本像素
				// 对应的全分辨率采样点。
				vec3 _dbgCol = (renderTexel.x < (int(viewWidth) >> 1)) ? _cacheCol : _refCol;
				result = vec4(_dbgCol, 1.0);
			#else
				result = vec4(_refCol, 1.0);
			#endif
		#else
			result = vec4(ProbeSampleRadiance(_pvc) * PROBE_GI_STRENGTH, 1.0);
		#endif
		#elif defined VOXEL_GI_ENABLED
			#ifdef VOXEL_REUSE
			// ---- ReSTIR Phase A：几何一致（绝对世界坐标门控）且 reservoir 有效 → 复用上帧，省追踪 ----
			ivec2 _rp = texelPos;
			vec4 _prev = PingReusePrev(_rp);
			// ① 几何一致：与上帧记录的"绝对世界坐标"比对（相对该点视距 length(viewPos) 归一化）。
			// 平移/转动都会让绝对世界点变化 → 一致才复用，否则重新追踪（消除平移/转动拖影）。
			vec3 _wbP = imageLoad(reservoirW, _rp).xyz;
			bool _consistent = (length(_wbP - _wpos) / max(length(viewPos), 1e-4) < VOXEL_REUSE_GEO);
			// 自适应稀疏：样本数 < THRESHOLD 时每帧重投快速收敛；>= THRESHOLD 才启用 interval 稀疏复用。
			// 全局相机运动时（!_camMoved=false）绝不复用：避免拖影与逐像素跳变。
			bool _sparse = (_prev.a >= VOXEL_REUSE_THRESHOLD);
			if (!_camMoved && _consistent && _sparse && ((frameCounter & (uint(VOXEL_REUSE_INTERVAL) - 1u)) != 0u)) {
				// 复用：输出 reservoir 累积均值（低方差）；样本计数递增封顶
				result = vec4(RGBToYCoCg(_prev.rgb), 1.0);
				imageStore(colorimg3, texelPos, result);
				vec4 _cr = vec4(_prev.rgb, min(_prev.a + 1.0, VOXEL_REUSE_MCAP));
				if ((frameCounter & 1u) == 0u) imageStore(reservoirA, _rp, _cr); else imageStore(reservoirB, _rp, _cr);
				return;
			}
			#endif
			// 体素 GI 优先：信号源 = 每像素漫反射追踪（棋盘半分辨率 1 SPP，与 SSILVB 同套路：
			// 每帧只更新 1/4 像素，时域由 Accumulate 补全；信号存 colortex3 左上象限）。
			// 入射光（不乘 albedo）——albedo 在 DeferredLight 读回时补乘，
			// 与旧全分辨率路径（VoxelTracePixel × albedo × STRENGTH）视觉语义一致。
			vec3 worldNormal = FetchSurfaceNormal(renderTexel);
			vec3 geoNormal = FetchGeometryNormal(renderTexel);
			vec2 lightmap = Unpack2x8U(loadMaterialPack(renderTexel).x);
			// [2026-08-18] 追踪出界天光门控：像素级 lightmap.y（MC 平滑光照，稳定）。
			// 此前 bbb7c28 尝试 max(lightmap, IRC 曝光度) 修复"阴影红但黑"，后改用
			// max(体素 skylight, 曝光度) 对齐 IRC 端 → 玩家移动时像素所在格在
			// 固体/空气间切换（空气格 voxelData.w=0）→ 门控 1.0/0 跳变 → 全场景闪
			// （用户实测）。恢复 lightmap.y：平滑、无格切换跳变；洞穴 lightmap≈0
			// 仍被门控，开阔阴影 lightmap.y 高仍全量。洞穴口残留 lightmap 的天光
			// 由 IRC 曝光度链路另行处理，不在追踪端叠加。
			vec3 voxelCoord = mat3(gbufferModelViewInverse) * viewPos + cameraPositionFract + float(VOXEL_RADIUS);
			float skyLightmap = lightmap.y;
			// 种子：全分辨率像素索引哈希 + 帧计数（每帧不同方向，棋盘 offset 轮转 4 帧全覆盖）
			uint traceSeed = triple32(uint(renderTexel.x + renderTexel.y * int(viewWidth)) * 0x9E3779B1u
			                          + uint(frameCounter + 1) * 0x85EBCA77u);
			// [2026-08-19 离线渲染] 同帧多 SPP 漫反射追踪平均（对齐 RENDERING_MODE 思路：多射线 + 帧累积，
			// 而非仅屏噪靠时域磨）。seed inout 于循环内递增 → 每次独立方向。
			#ifdef OFFLINE_RENDER
				vec3 traceAcc = vec3(0.0);
				for (int s = 0; s < VOXEL_TRACE_OFFLINE_SPP; ++s) {
					traceAcc += VoxelTracePixel(mat3(gbufferModelViewInverse) * viewPos, worldNormal, geoNormal,
					                            -viewPos.z, skyLightmap, lightmap.x, renderTexel, s, traceSeed);
				}
				result = vec4(traceAcc * rcp(float(VOXEL_TRACE_OFFLINE_SPP)) * VOXEL_GI_TRACE_STRENGTH, 1.0);
			#else
			// [2026-08-21 实时 SPP] 实时模式也支持同帧多射线：VOXEL_TRACE_SPP 默认 1（现状），
			// 调大后多射线平均 → 单帧降噪、时域收敛更快（性能按比例增）。与离线宏独立。
				vec3 traceAcc = vec3(0.0);
				for (int s = 0; s < VOXEL_TRACE_SPP; ++s) {
					traceAcc += VoxelTracePixel(mat3(gbufferModelViewInverse) * viewPos, worldNormal, geoNormal,
					                            -viewPos.z, skyLightmap, lightmap.x, renderTexel, s, traceSeed);
				}
				result = vec4(traceAcc * rcp(float(VOXEL_TRACE_SPP)) * VOXEL_GI_TRACE_STRENGTH, 1.0);
			#endif
		#else
			vec3 worldNormal = FetchSurfaceNormal(renderTexel);
			float lightmapSky = Unpack2x8UY(loadMaterialPack(renderTexel).x);

			result = CalculateSSILVB(screenCoord, viewPos, worldNormal, lightmapSky);
		#endif
		#if defined VOXEL_GI_ENABLED && defined VOXEL_REUSE
			// ---- ReSTIR：几何一致才与上帧均值合并，否则重置为新样本（避免转动/移动把旧几何混入残影）；随后记录本像素几何 ----
			{
				vec4 _pW = PingReusePrev(texelPos);
				// ① 本像素几何一致（绝对世界坐标）：平移/转动都会使其变化 → false → 重置为新样本。
			// 全局相机运动（_camMoved）时强制 false：本帧一律不复用/不合并，消除拖影与跳变。
			vec3 _wPrev = imageLoad(reservoirW, texelPos).xyz;
			bool _geoMatch = !_camMoved && (length(_wPrev - _wpos) / max(length(viewPos), 1e-4) < VOXEL_REUSE_GEO);
				if (_geoMatch) {
				    // ② 空间复用：仅静止一致时才合并上帧十字 4-邻域（绝对世界坐标一致）提样本。
				    // 平移/转动时不被启用，避免把旧视角邻居混入 → 消除拖影。
				    vec3 _accS = vec3(0.0); float _aS = 0.0; float _aM = _pW.a;
				    for (int _dir = 0; _dir < 4; ++_dir) {
				        ivec2 _delta = ivec2(0);
				        if (_dir == 0) _delta = ivec2( 0, -1);
				        else if (_dir == 1) _delta = ivec2( 1,  0);
				        else if (_dir == 2) _delta = ivec2( 0,  1);
				        else            _delta = ivec2(-1,  0);
				        ivec2 _av = texelPos + _delta;
				        if (clamp(_av, ivec2(0), (ivec2(viewWidth, viewHeight) >> 1) - 1) == _av) {
				            vec4 _nv = PingReusePrev(_av);
				            if (_nv.a > 0.5) {
				                vec3 _nwP = imageLoad(reservoirW, _av).xyz;
				                if (length(_nwP - _wpos) / max(length(viewPos), 1e-4) < VOXEL_REUSE_GEO) {
				                    _accS += _nv.rgb * _nv.a; _aS += _nv.a; _aM = max(_aM, _nv.a);
				                }
				            }
				        }
				    }
				    if (_aS > 0.05) { _pW.rgb = _accS / _aS; _pW.a = min(_aM, VOXEL_REUSE_MCAP); }
				}
				bool _valid = _geoMatch && _pW.a > 0.5;
				float _M = _valid ? min(_pW.a + 1.0, VOXEL_REUSE_MCAP) : 1.0;
				vec3 _mean = _valid ? ((_pW.rgb * _pW.a) + result.rgb) / (_pW.a + 1.0) : result.rgb;
				vec4 _crW = vec4(_mean, _M);
				if ((frameCounter & 1u) == 0u) imageStore(reservoirA, texelPos, _crW); else imageStore(reservoirB, texelPos, _crW);
				// 记录本像素"绝对世界坐标"作为下一帧一致性基准（RGBA32F 保远距离精度）
				imageStore(reservoirW, texelPos, vec4(_wpos, 0.0));
			}
#endif
			result.rgb = RGBToYCoCg(result.rgb); // Convert to YCoCg color space (for filtering)
		imageStore(colorimg3, texelPos, result);
	} else {
		imageStore(colorimg3, texelPos, vec4(0.0));
	}
}
