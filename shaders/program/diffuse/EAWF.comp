layout (local_size_x = 8, local_size_y = 8) in;

//======// Utility //=============================================================================//

#include "/lib/Utility.glsl"

// 与 GI 画布同分辨率（默认半分辨率棋盘；VOXEL_GI_FULLRES 全分辨率）。须在 Utility 之后。
#ifdef VXGI_FULLRES
const vec2 workGroupsRender = vec2(1.0, 1.0);
#else
const vec2 workGroupsRender = vec2(0.5, 0.5);
#endif

//======// Image //===============================================================================//

// a-trous ping-pong：compute pass 不会自动 flip（Iris 只在有片元的程序后 flip），
// 同一张 image 上 imageLoad 邻居再 imageStore = 同一 dispatch 内的读写竞态。
// 四个 pass 在 colortex3 与 colortex25 之间交替读写：
//   pass0: 3 -> 25 / pass1: 25 -> 3 / pass2: 3 -> 25 / pass3: 25 -> 3（最终结果回到 colortex3）。
layout (rgba16f) restrict uniform image2D colorimg3;
layout (rgba16f) restrict uniform image2D colorimg25;

#if (FILTER_PASS_INDEX % 2) == 0
    #define EAWF_SRC colorimg3
    #define EAWF_DST colorimg25
#else
    #define EAWF_SRC colorimg25
    #define EAWF_DST colorimg3
#endif

//======// Uniform //=============================================================================//

#include "/lib/universal/Uniform.glsl"

//======// Function //============================================================================//

#include "/lib/universal/Random.glsl"
#include "/lib/universal/Fetch.glsl"
#include "/lib/universal/Transform.glsl"

#ifndef GI_ROT_PER_FRAME
    #define GI_ROT_PER_FRAME 0.0
#endif

//======// NRD 风格滤波参数 //==================================================================//
// hit-distance 世界空间滤波半径：每 pass 的世界空间覆盖近似恒定——近处物体每屏像素
// 覆盖的世界范围小，步长相应放大；远处则收窄防过度模糊。单位 = 米；0 = 用固定像素步长。
#ifndef NRD_RADIUS
    #define NRD_RADIUS 0.5 // [0.0 0.05 0.1 0.15 0.2 0.3 0.5 0.75 1.0] 世界空间滤波半径（米）
#endif

// 去遮挡修复（colortex14.a = 1 = 不可靠）：不可靠像素放大空间步长，从周围可靠邻居补填。
// 0 = 关闭；1.0 = 均衡；越大越强。
#ifndef NRD_DISOCCLUSION
    #define NRD_DISOCCLUSION 0.5 // [0.0 0.5 1.0 2.0 4.0] 去遮挡修复强度
#endif

//======// Main //================================================================================//
void main() {
	uvec2 localPos = QuadLayout8x8(gl_LocalInvocationIndex);
	ivec2 texelPos = ivec2(localPos + gl_WorkGroupID.xy * gl_WorkGroupSize.xy);

#ifdef VXGI_FULLRES
	ivec2 canvasEnd = ivec2(viewSize);
	float canvasHeight = viewSize.y;
#else
	ivec2 canvasEnd = ivec2(halfViewSize);
	float canvasHeight = halfViewSize.y;
#endif

	// 关降噪（仅光追路径）：透传，保持棋盘信号；SSILVB 不受影响（照常滤波）。
	#ifdef GI_ACTIVE_VXGI
		#ifndef VOXEL_GI_DENOISE
			imageStore(EAWF_DST, texelPos, imageLoad(EAWF_SRC, texelPos));
			return;
		#endif
	#endif
	// 离线渲染：屏蔽空间降噪，靠时域累积收敛。
	#ifdef OFFLINE_RENDER
		imageStore(EAWF_DST, texelPos, imageLoad(EAWF_SRC, texelPos));
		return;
	#endif

	f16vec4 normalDepthData = f16vec4(texelFetch(colortex14, texelPos, 0));
	float disoccF = float(normalDepthData.a) * NRD_DISOCCLUSION;
	float stepBoost = 1.0 + disoccF;

	f16vec4 centerSample = f16vec4(imageLoad(EAWF_SRC, texelPos));
	if (any(isnan(centerSample.rgb)) || any(isinf(centerSample.rgb))) centerSample.rgb = f16vec3(0.0);

	// 时域累积帧数少（刚出现/刚重投影）→ 该处噪声高，放大步长让空间滤波更快收敛。
	float frameIndex = texelFetch(colortex2, texelPos, 0).a;
	{
		float _under = clamp(10.0 - frameIndex, 0.0, 10.0) * 0.1; // 0..1，少于 ~10 帧
		stepBoost *= 1.0 + _under * 0.6;
	}

	// 画布坐标 → 视线方向 / 屏幕纹素。`texelToUv` 是全分辨率像素尺寸，画布上直接用会压 UV。
	vec2 centerCanvasUv = (vec2(texelPos) + 0.5) / vec2(canvasEnd);
	vec3 viewDir = ScreenToViewDirRaw(centerCanvasUv);
#ifdef VXGI_FULLRES
	ivec2 centerScreenTexel = texelPos;
#else
	ivec2 centerScreenTexel = texelPos * 2 + GI_CANVAS_PHASE;
#endif
	vec3 geoNormal = mat3(gbufferModelView) * FetchGeometryNormal(centerScreenTexel);
	float NdotV = abs(dot(geoNormal, viewDir));

	// 各向异性步长：沿几何切向拉伸，法向收窄；随 pass 指数递增（1,2,4,8…）
	vec2 offsetScaleBase = oms(abs(geoNormal.xy) * oms(NdotV)) * ldexp(2.0, FILTER_PASS_INDEX);

	float viewDist = max(-float(normalDepthData.z), 0.25);
	float pxPerWorldAtZ1 = canvasHeight * gbufferProjection[1][1];
	float depthFactor = NRD_RADIUS <= 0.0 ? 1.0
	                    : clamp(NRD_RADIUS * pxPerWorldAtZ1 / viewDist, 0.5, 1.5);

	// 官方 Blur：`blurRadius *= sqrt( hitDistFactor * nonLinearAccumSpeed )`
	//   hitDistFactor = saturate( hitDistance / frustumSize )   （命中越近，半径越小以保接触）
	//   nonLinearAccumSpeed 随累积帧数增长（官方 fade 项），刚出现的像素半径更小、收敛更快。
	float normHit = 1.0;   // 非 NRD 模式没有 prepass 命中距离 ⇒ 不缩放半径
#ifdef VOXEL_GI_NRD_ACTIVE
	normHit = saturate(float(texelFetch(colortex22, texelPos, 0).a));
#endif
	float hitDist = normHit * (3.0 + viewDist * 0.1);                    // ReblurHitDistanceParameters A + viewZ*B
	float frustumSize = 2.0 * viewDist * rcp(max(gbufferProjection[1][1], 1e-3));
	float hitDistFactor = saturate(hitDist * rcp(max(frustumSize, 1e-3)));
	float fade = saturate(1.0 - frameIndex * 0.05);                      // GetFadeBasedOnAccumulatedFrames
	float nonLinearSpeed = rcp(1.0 + fade * max(frameIndex, 1.0));
	float radiusScale = sqrt(max(hitDistFactor * nonLinearSpeed, 0.05));

	vec2 offsetScale = offsetScaleBase * depthFactor * stepBoost * radiusScale;
	// 每轴至少 1 px：掠射面上 offsetScaleBase 会被压到 <0.5，整列 tap 塌到中心 ⇒ 9-tap 退化成 1D 条带。
	offsetScale = max(offsetScale, vec2(1.0));

	// 旋转：每像素固定 hash + 每 pass 黄金角（≈137.5°，让四级方向均匀铺开）。
	float _tapAng = hash13(vec3(texelPos, float(FILTER_PASS_INDEX))) * 6.2831853
	              + float(FILTER_PASS_INDEX) * 2.39996323
	              + GI_ROT_PER_FRAME * float(frameCounter) * 2.39996323;
	mat2 _tapRot = mat2(cos(_tapAng), sin(_tapAng), -sin(_tapAng), cos(_tapAng));

	// 官方几何/法线/命中距离参数
	const float PLANE_DIST_SENS = 0.02;   // planeDistanceSensitivity
	const float LOBE_COS = 0.9723699;     // cos(lobeAngleFraction(0.15) × 90°)
	const float MIN_HITDIST_WEIGHT = 0.1; // minHitDistanceWeight

	vec3 centerViewPos = ScreenToViewPosRaw(centerCanvasUv, normalDepthData.z);
	vec3 centerN = mat3(gbufferModelView) * vec3(OctDecodeSnorm(normalDepthData.xy));

	// 官方 Poisson 盘（REBLUR_POISSON_SAMPLE_NUM = 8）。这里用黄金角 Vogel 螺旋生成 8 个
	// 等面积样本（比固定表更均匀），再整体按像素/Pass 旋转，等价于官方 rotated Poisson disk。
	const int POISSON_SAMPLES = 8;
	f16vec3 sumRGB = centerSample.rgb;
	float sumW = 1.0;

	for (int i = 0; i < POISSON_SAMPLES; ++i) {
		float rn = sqrt((float(i) + 0.5) * rcp(float(POISSON_SAMPLES)));   // 0..1
		float an = float(i) * 2.39996323;
		ivec2 smp = texelPos + ivec2(round(_tapRot * (vec2(cos(an), sin(an)) * rn * offsetScale)));
		if (clamp(smp, ivec2(1), canvasEnd - 2) != smp) continue;

		f16vec3 sampleAux = f16vec3(texelFetch(colortex14, smp, 0).rgb);
		f16vec4 sampleColVar = f16vec4(imageLoad(EAWF_SRC, smp));
		if (any(isnan(sampleColVar.rgb)) || any(isinf(sampleColVar.rgb))) continue;

		// 几何：tap 到中心切平面的归一化偏离（官方 planeDistanceSensitivity）
		vec2 tapCanvasUv = (vec2(smp) + 0.5) / vec2(canvasEnd);
		vec3 tapViewPos = ScreenToViewPosRaw(tapCanvasUv, sampleAux.z);
		float planeDist = abs(dot(tapViewPos - centerViewPos, centerN)) / max(abs(centerViewPos.z), 1e-3);
		// 容差下限：0.02 是相对视距的百分比，近距离折成绝对距离会极小 ⇒ 会误拒同表面 tap。
		float planeTol = max(PLANE_DIST_SENS, 2.0 * rcp(max(abs(centerViewPos.z), 1.0)));
		float w = saturate(1.0 - planeDist * rcp(planeTol));

		// 法线：夹角上限 = 瓣角 × lobeAngleFraction（官方 lobeAngleFraction）
		float _nd = dot(OctDecodeSnorm(sampleAux.xy), vec3(OctDecodeSnorm(normalDepthData.xy)));
		w *= smoothstep(LOBE_COS - 0.02, LOBE_COS + 0.02, _nd);

		// 命中距离：越近的样本越易受遮挡影响 ⇒ 降权（官方 minHitDistanceWeight）
#ifdef VOXEL_GI_NRD_ACTIVE
		w *= mix(MIN_HITDIST_WEIGHT, 1.0, saturate(float(texelFetch(colortex22, smp, 0).a)));
#endif

		// 高斯：官方 GetGaussianWeight( offset.z )，offset.z 是该样本在盘内的归一化半径
		w *= exp(-2.0 * rn * rn);

		sumRGB += sampleColVar.rgb * f16vec3(w);
		sumW += w;
	}

	f16vec3 result = sumRGB * f16vec3(rcp(sumW));
	// .a 是方差字段（VarianceEstimate 写入）：空间滤波不改变它，原样透传中心值。
	imageStore(EAWF_DST, texelPos, min(f16vec4(result, centerSample.a), FP16_MAX));
}
