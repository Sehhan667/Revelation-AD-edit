/*
--------------------------------------------------------------------------------
  Revelation-AD-edit  —  REBLUR 主历史回流（Recurrent）+ TS 历史快照
--------------------------------------------------------------------------------

  本 pass 做两件事，都只在 NRD 路径（VOXEL_GI_NRD_ACTIVE）下有效。

  ① TS 历史快照 → colortex24

     GIStabilize 在同一 dispatch 里采样自己的历史、又写本帧输出，而 compute 不 flip
     ⇒ 读写同一张图是真竞态（EAWF 当年因此改乒乓）。这里先把**上一帧** colortex23
     快照到 colortex24，GIStabilize 改读快照、仍写 colortex23 ⇒ 读写分离。
     为什么是 24：colortex25 现在是 EAWF 的最终输出（官方 PostBlur 位置），
     不能再兼作快照缓冲。colortex24 原本只存 GIPrepass 的调试方差，本轮已让出。

  ② 主历史回流 → colortex2

     官方（2026-11-11 用资源生命周期标签确证；论文 Zhdan, D. "ReBLUR: A Hierarchical
     Recurrent Denoiser", Ray Tracing Gems II 2021 ch.49）：

         TA 的 gOut_Diff         = NRD_RESOURCE_TRANSIENT
         Blur 的 gOut_Diff       = NRD_RESOURCE_TRANSIENT
         HistoryFix 的 gOut_Diff = NRD_RESOURCE_OUT
         **PostBlur 的 gOut_Diff = NRD_RESOURCE_PERMANENT**   ← 唯一
         TA 的 gHistory_Diff     = NRD_RESOURCE_PERMANENT（REBLUR_TemporalAccumulation.resources.hlsli:34）

     ⇒ 下一帧的主历史 = 本帧空间滤波的最终输出（官方 PostBlur = 我们的 EAWF deferred7）。
        即 H_{n+1} = Filter( lerp(H_n, 本帧输入, alpha) )：同一个核被逐帧迭代，
        等效滤噪力度随历史长度增长 —— 这是 REBLUR 被称为 *recurrent* 的原因。

     本链对应：colortex25 = EAWF deferred7（PostBlur，radiusScale 2.0）= 官方 PostBlur 输出。
     只替换 rgb；`.a` 必须保留 Accumulate 写下的累积帧数（下一帧的 alpha 与计数都靠它）。
--------------------------------------------------------------------------------
*/

//======// Input //===============================================================================//

layout (local_size_x = 8, local_size_y = 8) in;

//======// Utility //=============================================================================//

#include "/lib/Utility.glsl"

#ifdef VXGI_FULLRES
const vec2 workGroupsRender = vec2(1.0, 1.0);
#else
const vec2 workGroupsRender = vec2(0.5, 0.5);
#endif

//======// Uniform //=============================================================================//

layout (rgba16f) restrict uniform image2D colorimg2;             // 主历史（下一帧 Accumulate 的输入）
layout (rgba16f) restrict readonly uniform image2D colorimg25;   // 本帧 EAWF（空间滤波）最终输出
layout (rgba16f) restrict uniform image2D colorimg24;            // TS 历史快照

#include "/lib/universal/Uniform.glsl"

//======// Main //================================================================================//

void main() {
    ivec2 texelPos = ivec2(gl_GlobalInvocationID.xy);

#ifdef VXGI_FULLRES
    if (any(greaterThanEqual(texelPos, ivec2(viewSize)))) return;
#else
    if (any(greaterThanEqual(texelPos, ivec2(halfViewSize)))) return;
#endif

    // colortex23 只在 NRD 模式由 GIStabilize 写入，读写都必须同层保护（语义检查 R3）。
#ifdef VOXEL_GI_NRD_ACTIVE
    // ---- ① TS 历史快照 ----
    // 此刻 colortex23 仍是**上一帧** GIStabilize 的输出（deferred11 还没跑）。
    imageStore(colorimg24, texelPos, texelFetch(colortex23, texelPos, 0));

    // ---- ② 主历史回流 ----
    // GI_RECURRENT_HISTORY = 0 时退回"历史只存原始累积"（SVGF 式）；
    // GI_BISECT bit1 也可强制关掉，作为调试侧的等效回退。
    if (GI_RECURRENT_HISTORY <= 0 || (GI_BISECT & 2) != 0) return;

    vec4 mixed = imageLoad(colorimg2, texelPos);
    vec3 filtered = imageLoad(colorimg25, texelPos).rgb;

    // .a 保留累积帧数，只替换 rgb（滤波输出的 .a 不是帧数，不能用）
    imageStore(colorimg2, texelPos, vec4(filtered, mixed.a));
#endif
}
