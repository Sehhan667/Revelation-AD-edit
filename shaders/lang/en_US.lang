# Post-Processing
option.DEPTH_OF_FIELD=Depth of Field
option.DEPTH_OF_FIELD.comment=Simulates real-camera lens blur (bokeh): objects on the focus plane stay sharp while off-focus objects blur by a growing circle of confusion. Pair it with TAA for a smoother bokeh.
option.CAMERA_FOCUS_MODE=Focus Mode
option.CAMERA_FOCUS_MODE.comment=Auto: continuously racks focus onto the nearest object near screen center. Manual: fixes the focus plane using Manual Focus Distance, independent of view direction.
value.CAMERA_FOCUS_MODE.0=Auto
value.CAMERA_FOCUS_MODE.1=Manual
option.DOF_FOCUS_IGNORE_HAND=Ignore Hand When Focusing
option.DOF_FOCUS_IGNORE_HAND.comment=When enabled, autofocus ignores the held item in view so a raised hand/block does not steal the focus point.
option.DOF_FOCAL_LENGTH=Focal Length
option.DOF_FOCAL_LENGTH.comment=Lens focal length (mm). Larger values narrow the field of view, compress perspective and give shallower DoF. 50mm is the classic standard lens.
suffix.DOF_FOCAL_LENGTH=mm
option.DOF_F_STOP=F-Stop
option.DOF_F_STOP.comment=Aperture f-number. Smaller values mean a wider aperture (more light) and shallower DoF with more background blur; larger values give a deeper focus. Controls overall DoF strength.
option.DOF_APERTURE_SHAPE=Aperture Shape
option.DOF_APERTURE_SHAPE.comment=Aperture blade shape sets the bokeh highlight shape. Circular = smooth bokeh; Hexagonal = a typical 6-blade lens effect.
value.DOF_APERTURE_SHAPE.0=Circular
value.DOF_APERTURE_SHAPE.1=Hexagonal
option.DOF_APERTURE_VIGNETTING=Aperture Vignetting
option.DOF_APERTURE_VIGNETTING.comment=Simulates optical vignetting at the lens rim: bokeh near screen corners is squashed into ellipses/cat-eye shapes, more compressed toward the edges.
option.DOF_GATHER_SAMPLES=Gather Sample Count
option.DOF_GATHER_SAMPLES.comment=Bokeh gather samples per pixel. Higher values give rounder, less noisy bokeh at a higher performance cost.
option.DOF_COC_SPREAD_SAMPLES=CoC Search Sample Count
option.DOF_COC_SPREAD_SAMPLES.comment=Samples used to spread the Circle of Confusion, controlling how smoothly blur is propagated across foreground seams.
option.DOF_MAX_BLUR_RADIUS=Maximum Blur Radius
option.DOF_MAX_BLUR_RADIUS.comment=Maximum circle-of-confusion blur radius in pixels. Larger allows more extreme out-of-focus blur.
suffix.DOF_MAX_BLUR_RADIUS=px
option.DOF_FOCUS_HALFLIFE=Focus Response Half-Life
option.DOF_FOCUS_HALFLIFE.comment=Autofocus tracking half-life (seconds). Smaller reacts faster, larger gives smoother, slower rack focusing.
suffix.DOF_FOCUS_HALFLIFE=s
option.DOF_MANUAL_FOCUS_DISTANCE=Manual Focus Distance
option.DOF_MANUAL_FOCUS_DISTANCE.comment=Distance (meters) of the focus plane from the camera in manual mode. Objects at this distance are sharpest; those nearer/farther blur increasingly.
suffix.DOF_MANUAL_FOCUS_DISTANCE=m

option.CHROMATIC_ABERRATION=Chromatic Aberration
option.CHROMATIC_ABERRATION.comment=Lateral chromatic aberration: radially separates the R and B channels from the G channel near the frame edge, producing a realistic red/blue lens fringe. No separation at the center, strongest at the corners.
option.CHROMATIC_ABERRATION_STRENGTH=Chromatic Aberration Strength
option.CHROMATIC_ABERRATION_STRENGTH.comment=Peak channel offset in pixels at the screen corners. Higher values give a stronger fringe.
suffix.CHROMATIC_ABERRATION_STRENGTH=px

