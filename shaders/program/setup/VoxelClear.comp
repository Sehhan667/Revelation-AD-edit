	Pass: Clear voxelization buffers (albedo + light) before gbuffers.

	原因：gbuffers 使用 imageAtomicMax 累加体素化结果，若不在每帧开始前清空，
	跨帧最大值会残留形成"鬼影"；同时必须赶在 gbuffers 之前清空，
	deferred22 才能稳定读到本帧完整数据（旧实现"先清后读"导致注入永远为 0）。

--------------------------------------------------------------------------------

*/

layout (local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

// VOXEL_AREA 等配置来自 settings.glsl（其内部 include VoxelLighting.glsl）。
// 不用 VoxelLighting.glsl 直接：tile 布局宏引用 shadowMapResolution（VoxelLighting.glsl
// L24），必须先有 settings.glsl L22 的定义，否则函数体内的宏展开会编译失败。
#include "/settings.glsl"

#if VOXEL_AREA == 32
	const ivec3 workGroups = ivec3(8, 8, 8);
#elif VOXEL_AREA == 128
	const ivec3 workGroups = ivec3(32, 32, 32);
#else
	const ivec3 workGroups = ivec3(16, 16, 16);
#endif

// 无显式 binding：与 Terrain.frag / 传播端保持一致，交由 Iris 按名字自动绑定。
// 显式 binding 会与 Iris 给普通贴图分配的硬件纹理单元冲突（全黑根因），做法。
// 格式限定符必须保留：voxelData 为 rgba16f，voxelLightData/voxelCoarse 为 r32ui。
layout (rgba16f) writeonly uniform image3D voxelData;
layout (r32ui) writeonly uniform uimage3D voxelLightData;
layout (r32ui) writeonly uniform uimage3D voxelCoarse;
layout (r32ui) writeonly uniform uimage3D voxelMask;

void main() {
	#if !defined GI_ACTIVE_VXGI && !defined GI_ACTIVE_IRC
		return;
	#endif

	ivec3 c = ivec3(gl_GlobalInvocationID.xyz);
	imageStore(voxelData, c, vec4(0.0));          // z=voxelID=0 即空体素（gbuffers 只写命中格，必须清空防跨帧残留）
	imageStore(voxelLightData, c, uvec4(0u));
	// coarse occupancy：以 c>>SHIFT 定位粗块清零；多个细格映射同一粗块，重复清 0 无害。
	imageStore(voxelCoarse, c >> VOXEL_COARSE_SHIFT, uvec4(0u));
	// 细格 occupancy：尺寸 VOXEL_COARSE_N x VOXEL_COARSE_N x VOXEL_COARSE_N*2，本中原遍历覆盖其整个体，重复清 0 无害。
	if (all(lessThan(c, ivec3(VOXEL_COARSE_N, VOXEL_COARSE_N, VOXEL_COARSE_N * 2)))) imageStore(voxelMask, c, uvec4(0u));
	// 注意：probeRadiance（探针辐照度缓存）**不能**每帧清零——探针是跨帧时域 EMA 累积，
	// round-robin 每帧只更新 1/PROBE_UPDATE_PERIOD 的格，其余格靠 EMA 保留跨帧值；
	// 若每帧清 0，未更新格全变 0，缓存几乎恒 0 → 探针 GI 看不见（"开启无变化"根因）。
	// 首帧 NaN/垃圾由 ProbeUpdate.comp 的 EMA 内 NaN 防御处理。
}
