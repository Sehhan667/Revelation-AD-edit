#endif
// [GUI 布尔锚点 2026-09-06] VOXEL_CONE_GI（锥追踪低质量加速档，Voxel Cone Tracing 思想）。
#ifdef VOXEL_CONE_GI
#endif
#ifdef GI_ACTIVE_VXGI
    // 体素 GI 信号源（阶段④：与 SSILVB 互斥，体素优先）：
    // IRC 采样器/查询 + 每像素漫反射追踪（VoxelTracing 内含 VoxelData/VoxelShape）
    #include "/lib/lighting/VoxelGI.glsl"
    // 方块图集（shaders.properties customTexture.atlas2D = blocks.png，与传播端同图集；
    // 无显式 binding：Iris 按名字自动绑定）
    uniform sampler2D atlas2D;
    // [FIX 2026-08-06] 追踪端阳光反弹的阴影判定依赖（sunVis，与注入端 VoxelGI.frag 一致）：
    // DistortShadowSpace 来自 shadow/Common.glsl；shadowtex1 按名绑定。此前追踪端阳光只靠
    // skylight 门控（×444 阈值极低）→ 地下/背阴有微弱 sky 残留就 8.0 倍阳光反弹 → 到处亮。
    #include "/lib/lighting/shadow/Common.glsl"
    uniform sampler2DShadow shadowtex1;
    #include "/lib/lighting/VoxelTracing.glsl"
    #ifdef VOXEL_CONE_GI
    #include "/lib/lighting/VoxelCone.glsl"
    #endif
#endif

float GetClosestDepthN(in ivec2 texel) {
    float depth = 1.0;

    for (uint i = 0u; i < 8u; ++i) {
        ivec2 sampleTexel = offset3x3N[i] + texel;
        float sampleDepth = loadDepth0(sampleTexel);
        depth = min(depth, sampleDepth);
    }

    return depth;
}

//======// Main //================================================================================//
void main() {
    uvec2 localPos = QuadLayout16x16(gl_LocalInvocationIndex);
    ivec2 texelPos = ivec2(localPos + gl_WorkGroupID.xy * gl_WorkGroupSize.xy);

    // [2026-09-06 VOXEL_CONE_GI] IRC 辐照度/占用 mip 金字塔构建：全 dispatch 分摊任务
    //（读上一帧 IRC 块 → 写当前奇偶组；采样端读另一组，同 dispatch 无竞争）。
    #if defined GI_ACTIVE_VXGI && defined VOXEL_CONE_GI
        {
            // GLSL 无 gl_GlobalInvocationIndex：用填充后的组网格尺寸自算唯一线性号
            int _padX = ((int(viewWidth) >> 1) + 15) / 16 * 16;
            int _padY = ((int(viewHeight) >> 1) + 15) / 16 * 16;
            int _total = max(_padX * _padY, 1);
            int _lin = int(gl_GlobalInvocationID.y) * _padX + int(gl_GlobalInvocationID.x);
            for (int _tk = _lin; _tk < int(VOXEL_CONEMIP_TASKS); _tk += _total)
                VoxelMipBuildTask(uint(_tk));
        }
    #endif

    // Keep the compatibility-forced deferred1_a pass inert when GI_MODE=0.
    #if !defined GI_ACTIVE_SSILVB && !defined GI_ACTIVE_VXGI && !defined GI_ACTIVE_IRC && !defined PROBE_GI_ENABLED
        imageStore(colorimg3, texelPos, vec4(0.0));
        return;
    #endif

#ifdef PROBE_GI_ENABLED
    // [Plan B] 同一 dispatch 内先更新缓存（写 B 读 A 乒乓），再执行查询（读另一块 = 上帧值）。
    // 放最前，无视地形/早期 return，保证 4096 探针每帧全量覆盖；写 B 读 A（不同纹理），无同 dispatch 读写冲突。
    ProbeUpdateSlice(texelPos);
#endif

	#ifdef GI_ACTIVE_IRC
	ivec2 renderTexel = texelPos * 2;
	#else
	ivec2 renderTexel = texelPos * 2 + checkerboardOffset2x2[frameCounter & 3u];
	#endif
	float depth = loadDepth0(renderTexel);
	bool terrainCheck = min(GetClosestDepthN(renderTexel), depth) < 1.0;
	#if defined LOD_MOD
        bool lodMask = !terrainCheck;
		if (lodMask) {
			depth = loadDepth0Lod(renderTexel);
			terrainCheck = depth < 1.0;
		}
	#endif

	#ifdef VOXEL_REUSE
	// ---- [2026-09-01] 全局相机运动判定 ----
	// per-pixel 几何门控（绝对世界坐标）对"棋盘半分辨率、每帧换角落"极易误判：
	// 阈值一靠边就逐像素随机 复用/重置 → 既是拖影又是跳变的来源。改为按"全局相机是否运动"一票否决：
	// 相机平移或转动 → 本帧全体不复用/不合并，一律重追踪；完全静止才允许复用。
	// camTracker 存上帧 viewInverse 旋转列 + 相机世界位；thread(0,0) 每帧写入当前值，其余线程读上帧值。
	vec4 _ct0 = imageLoad(camTracker, ivec2(0, 0));
	vec4 _ct1 = imageLoad(camTracker, ivec2(1, 0));
	vec4 _ct2 = imageLoad(camTracker, ivec2(2, 0));
	vec4 _ct3 = imageLoad(camTracker, ivec2(3, 0));
	mat3 _mvi = mat3(gbufferModelViewInverse);
	bool _camMoved = length(_ct3.xyz - cameraPosition) > 0.01;
	_camMoved = _camMoved
	         || any(greaterThan(abs(_ct0.xyz - _mvi[0]), vec3(1e-4)))
	         || any(greaterThan(abs(_ct1.xyz - _mvi[1]), vec3(1e-4)))
	         || any(greaterThan(abs(_ct2.xyz - _mvi[2]), vec3(1e-4)));
	if (gl_GlobalInvocationID.x == 0u && gl_GlobalInvocationID.y == 0u) {
		imageStore(camTracker, ivec2(0, 0), vec4(_mvi[0], 0.0));
		imageStore(camTracker, ivec2(1, 0), vec4(_mvi[1], 0.0));
		imageStore(camTracker, ivec2(2, 0), vec4(_mvi[2], 0.0));
		imageStore(camTracker, ivec2(3, 0), vec4(cameraPosition, 0.0));
	}
	#endif

	#if defined PROBE_GI_ENABLED && defined DEBUG_PROBE_BIND_TEST
	// [自检 2026-09-03 v3 绑定二分 DEBUG_PROBE_BIND_TEST] 非 GUI 开关（文件直接生效，Iris 不覆盖）。
	// 屏分两半：
	//   左半 = image 直写直读自检：imageStore(本帧写块 probeDistance 的槽位, 橙) 后同调用 imageLoad。
	//          橙色调 → image 绑定与读写活着；黑 → image 绑定死（shaders.properties 条目问题）。
	//   右半 = sampler 读回乒乓另一块(上帧写的辐照度) → 有彩色 = sampler 绑定活 + 写端在跑；
	//          全黑 = 写端没跑或 sampler 绑定死。
	{
		bool _even = ((uint(frameCounter) & 1u) == 0u);
		// 左半自检（写 distance 图当前帧块，不污染右半读的辐照度图）
		vec3 _selfCol = vec3(0.0);
		{
			ivec3 _st = ivec3(texelPos.x & 127, texelPos.y & 127, 0);
			vec4 _sc = vec4(1.0, 0.45, 0.2, 1.0);
			if (_even) { imageStore(probeDistance, _st, _sc); _selfCol = imageLoad(probeDistance, _st).rgb; }
			else       { imageStore(probeDistance2, _st, _sc); _selfCol = imageLoad(probeDistance2, _st).rgb; }
		}
		// 右半：sampler 读上帧辐照度（各向同性均值）
		vec3 _sampCol = vec3(0.0);
		{
			vec2 _sUv = texelToUv(renderTexel);
			vec3 _vPos = ScreenToViewPos(vec3(_sUv, depth));
			vec3 _pvcP = mat3(gbufferModelViewInverse) * _vPos + cameraPositionFract + float(VOXEL_RADIUS);
			vec3 _wp = _pvcP + vec3(cameraPositionInt) - float(VOXEL_RADIUS);
			const float _G16 = float(PROBE_GI_GRID_SIZE) * 0.5;
			vec3 _go = (round(previousCameraPosition * rcp(PROBE_SPACING)) - _G16) * PROBE_SPACING;
			ivec3 _cell = clamp(ivec3(floor((_wp - _go) * rcp(PROBE_SPACING))),
			                    ivec3(0), ivec3(PROBE_GI_GRID_SIZE - 1));
			vec3 _iso = vec3(0.0);
			for (int _k = 0; _k < PROBE_OCT_SIZE * PROBE_OCT_SIZE; ++_k) {
				ivec2 _ot = ivec2(_k % PROBE_OCT_SIZE, _k / PROBE_OCT_SIZE);
				ivec3 _c3 = ProbeOctAtlasCoord(_cell, _ot + 1);
				vec4 _tv = _even
				         ? texelFetch(probeIrradiance2Sampler, _c3, 0)
				         : texelFetch(probeIrradianceSampler, _c3, 0);
				_iso += _tv.rgb;
			}
			_sampCol = _iso * rcp(float(PROBE_OCT_SIZE * PROBE_OCT_SIZE));
		}
		vec3 _half = (renderTexel.x < (int(viewWidth) >> 1)) ? _selfCol : _sampCol;
		imageStore(colorimg3, texelPos, vec4(RGBToYCoCg(_half * 6.0), 1.0));
	}
	return;
	#endif

	#if defined PROBE_GI_ENABLED && defined DEBUG_PROBE_QUERY
	// [管线自检 2026-09-03 v3] 全屏 A/B 对照，不 gate 在 terrainCheck 上：
	// 旧版把对照嵌在 if(terrainCheck) 内 → 天空/远景(depth≥1)像素直接 imageStore 0，
	// 视野一旦有大片天空就"半边完全没有图案"，误判为写端/读取挂了。
	// 这里提前整屏执行：左半=cacheCol 读回，右半=refCol 直算，两半都无视地形门控。
	// 判读：左半一片亮红 → deferred50 写端没在写缓存；左半与右半近似渐变 → 写端正常。
	{
		vec2 _sUv = texelToUv(renderTexel);
		vec3 _vPos = ScreenToViewPos(vec3(_sUv, depth));
		vec3 _pvcD = mat3(gbufferModelViewInverse) * _vPos + cameraPositionFract + float(VOXEL_RADIUS);
		imageStore(colorimg3, texelPos, vec4(RGBToYCoCg(fract((_pvcD + vec3(cameraPositionInt)) * rcp(16.0))), 1.0));
	}
	return;
	#endif

	#if defined PROBE_GI_ENABLED && defined DEBUG_PROBE_GI_VIZ
	// [调试 2026-09-03 探针格覆盖可视化] 覆盖内(vc∈[0,VOXEL_AREA))=纯绿、覆盖外=纯红。
	// 用纯色(不混 GI、不靠 GI 亮度),即使 GI 值为 0/黑 也能清晰看到覆盖范围。
	{
		vec2 _sUv = texelToUv(renderTexel);
		vec3 _vPos = ScreenToViewPos(vec3(_sUv, depth));
		vec3 _pvcV = mat3(gbufferModelViewInverse) * _vPos + cameraPositionFract + float(VOXEL_RADIUS);
		bool _inGrid = all(greaterThanEqual(_pvcV, vec3(0.0))) && all(lessThan(_pvcV, vec3(float(VOXEL_AREA))));
		vec3 _covCol = _inGrid ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
		imageStore(colorimg3, texelPos, vec4(RGBToYCoCg(_covCol), 1.0));
	}
	return;
	#endif

	if (terrainCheck) {
		#if defined LOD_MOD
			if (lodMask) depth = ViewToScreenDepth(ScreenToViewDepthLod(depth));
		#endif

    	vec2 screenCoord = texelToUv(renderTexel);
		vec3 viewPos = ScreenToViewPos(vec3(screenCoord, depth));
		// 绝对世界坐标（固定基准）——ReSTIR 几何一致性比较用它，不用 view 空间坐标：
		// view 坐标跟相机走，相机平移时该像素的 viewPos 几乎不变 → 检测不出平移 → 平移不重置 → 拖影。
		// gbufferModelViewInverse 第4列 = 相机世界位置，乘 vec4(viewPos,1) 即得像素击中的绝对世界点。
		vec3 _wpos = (gbufferModelViewInverse * vec4(viewPos, 1.0)).xyz;

		vec4 result;
		#if defined GI_ACTIVE_IRC && !defined PROBE_GI_ENABLED
			// [2026-09-04 IRC 逐格 GI] 免 SVGF：像素体素坐标直接三线性采样 IRC(1m) 光场。
			// [2026-09-04b 只保留阳光+方块光] IRC 的 alpha=天空曝光度(露天≈1、洞里≈0)。
			// 用 (1-alpha) 门控：露天把 IRC 的天光/环境部分收掉(交给完整 SH)，只留洞里/被遮挡的
			// 阳光+方块光；避免 IRC 与 SH 双重计天空 → 也恢复 SH 的方向性。
			vec3 _pvc = mat3(gbufferModelViewInverse) * viewPos + cameraPositionFract + float(VOXEL_RADIUS);
			{
				vec3 _ircHit = _pvc - FetchGeometryNormal(renderTexel) * 0.05
				             + vec3(cameraPositionInt - previousCameraPositionInt);
				vec3 _irc = vec3(0.0);
				float _skExp = 0.0;
				if (frameCounter >= 2 && all(greaterThanEqual(_ircHit, vec3(0.0))) && all(lessThan(_ircHit, vec3(VOXEL_AREA)))) {
                                       vec3 _fp = _ircHit - 0.5;
					ivec3 _fi = ivec3(floor(_fp));
					vec3 _ft = _fp - vec3(_fi);
					for (int _k = 0; _k < 8; ++_k) {
						ivec3 _fo = ivec3(_k & 1, (_k >> 1) & 1, (_k >> 2) & 1);
						ivec3 _p = clamp(_fi + _fo, ivec3(0), ivec3(VOXEL_AREA - 1));
						float _w = (_fo.x == 0 ? 1.0 - _ft.x : _ft.x)
						         * (_fo.y == 0 ? 1.0 - _ft.y : _ft.y)
						         * (_fo.z == 0 ? 1.0 - _ft.z : _ft.z);
						vec4 _tv = ((frameCounter & 1) == 0)
						         ? texelFetch(voxelRadiance2Sampler, _p, 0)
						         : texelFetch(voxelRadianceSampler, _p, 0);
						if (any(isnan(_tv)) || any(isinf(_tv)) || any(lessThan(_tv, vec4(0.0)))) continue;
						_irc += _tv.rgb * _w;
						_skExp += _tv.a * _w;
					}
				}
				_irc *= 0.01;   // IRC ×100 存储 → 采样域 ×0.01
				if (!all(equal(_irc, _irc)) || any(lessThan(_irc, vec3(0.0)))) _irc = vec3(0.0);
				result = vec4(_irc * IRC_GI_STRENGTH, 1.0);
			}
		#elif defined PROBE_GI_ENABLED
			// IRC DDGI backend: directional octahedral irradiance and distance visibility.
			vec3 _pvc = mat3(gbufferModelViewInverse) * viewPos + cameraPositionFract + float(VOXEL_RADIUS);
			vec3 _cacheCol = ProbeSampleRadiance(_pvc,
				normalize(FetchSurfaceNormal(renderTexel)),
				normalize(mat3(gbufferModelViewInverse) * viewPos));
			#ifdef DEBUG_PROBE_QUERY
			// [管线自检 3 rework] A/B 同屏对照（DDGI）：
			//   左半屏 = 完整 DDGI 查询读回（被测对象：方向性探针辐照度 + 距离场遮挡）
			//   右半屏 = 网格坐标渐变色（钉世界、可当锚定基准）
			// 判读：左半应是平滑低频光斑（近亮/遮挡暗）、右半稳定渐变；左半不钉世界/随相机漂移
			// → 查询锚/重居中错；左半全黑 → 写端没写（查写端 dispatch）。只赋 RGB 原始值，勿预转 YCoCg。
			vec3 _refCol = fract((_pvc + vec3(cameraPositionInt)) * rcp(16.0));
			// 分屏阈值用全分辨率 renderTexel（texelPos 是半分辨率，范围[0,vw/2)）判定。
			vec3 _dbgCol = (renderTexel.x < (int(viewWidth) >> 1)) ? _cacheCol : _refCol;
			result = vec4(_dbgCol, 1.0);
		#else
			result = vec4(_cacheCol * IRC_GI_STRENGTH, 1.0);
		#endif
		#elif defined GI_ACTIVE_VXGI
			#ifdef VOXEL_CONE_GI
			// ---- [2026-09-06 锥追踪低质量档] IRC mip 金字塔半球锥采样（免每像素 ≤24 步 DDA）----
			// 5 锥(法线+45°环)×4 档 mip；近距细节让给 SSS 接触阴影与 SVGF 时域。入射光，albedo 由 DeferredLight 补乘。
			{
				vec3 coneN = normalize(FetchSurfaceNormal(renderTexel));
				vec3 coneG = normalize(FetchGeometryNormal(renderTexel));
				vec2 coneLM = Unpack2x8U(loadMaterialPack(renderTexel).x);
				vec3 coneOrigin = mat3(gbufferModelViewInverse) * viewPos + cameraPositionFract
				                 + float(VOXEL_RADIUS) + coneG * 0.15;
				result = vec4(VoxelConeIrradiance(coneOrigin, coneN, coneLM.y) * VOXEL_GI_TRACE_STRENGTH, 1.0);
			}
			#else
			#ifdef VOXEL_REUSE
			// ---- ReSTIR Phase A：几何一致（绝对世界坐标门控）且 reservoir 有效 → 复用上帧，省追踪 ----
			ivec2 _rp = texelPos;
			vec4 _prev = PingReusePrev(_rp);
			// ① 几何一致：与上帧记录的"绝对世界坐标"比对（相对该点视距 length(viewPos) 归一化）。
			// 平移/转动都会让绝对世界点变化 → 一致才复用，否则重新追踪（消除平移/转动拖影）。
			vec3 _wbP = imageLoad(reservoirW, _rp).xyz;
			bool _consistent = (length(_wbP - _wpos) / max(length(viewPos), 1e-4) < VOXEL_REUSE_GEO);
			// 自适应稀疏：样本数 < THRESHOLD 时每帧重投快速收敛；>= THRESHOLD 才启用 interval 稀疏复用。
			// 全局相机运动时（!_camMoved=false）绝不复用：避免拖影与逐像素跳变。
			bool _sparse = (_prev.a >= VOXEL_REUSE_THRESHOLD);
			if (!_camMoved && _consistent && _sparse && ((frameCounter & (uint(VOXEL_REUSE_INTERVAL) - 1u)) != 0u)) {
				// 复用：输出 reservoir 累积均值（低方差）；样本计数递增封顶
				result = vec4(RGBToYCoCg(_prev.rgb), 1.0);
				imageStore(colorimg3, texelPos, result);
				vec4 _cr = vec4(_prev.rgb, min(_prev.a + 1.0, VOXEL_REUSE_MCAP));
				if ((frameCounter & 1u) == 0u) imageStore(reservoirA, _rp, _cr); else imageStore(reservoirB, _rp, _cr);
				return;
			}
			#endif
			// 体素 GI 优先：信号源 = 每像素漫反射追踪（棋盘半分辨率 1 SPP，与 SSILVB 同套路：
			// 每帧只更新 1/4 像素，时域由 Accumulate 补全；信号存 colortex3 左上象限）。
			// 入射光（不乘 albedo）——albedo 在 DeferredLight 读回时补乘，
			// 与旧全分辨率路径（VoxelTracePixel × albedo × STRENGTH）视觉语义一致。
			vec3 worldNormal = FetchSurfaceNormal(renderTexel);
			vec3 geoNormal = FetchGeometryNormal(renderTexel);
			vec2 lightmap = Unpack2x8U(loadMaterialPack(renderTexel).x);
			// [2026-08-18] 追踪出界天光门控：像素级 lightmap.y（MC 平滑光照，稳定）。
			// 此前 bbb7c28 尝试 max(lightmap, IRC 曝光度) 修复"阴影红但黑"，后改用
			// max(体素 skylight, 曝光度) 对齐 IRC 端 → 玩家移动时像素所在格在
			// 固体/空气间切换（空气格 voxelData.w=0）→ 门控 1.0/0 跳变 → 全场景闪
			// （用户实测）。恢复 lightmap.y：平滑、无格切换跳变；洞穴 lightmap≈0
			// 仍被门控，开阔阴影 lightmap.y 高仍全量。洞穴口残留 lightmap 的天光
			// 由 IRC 曝光度链路另行处理，不在追踪端叠加。
			vec3 voxelCoord = mat3(gbufferModelViewInverse) * viewPos + cameraPositionFract + float(VOXEL_RADIUS);
			float skyLightmap = lightmap.y;
			// 种子：全分辨率像素索引哈希 + 帧计数（每帧不同方向，棋盘 offset 轮转 4 帧全覆盖）
			uint traceSeed = triple32(uint(renderTexel.x + renderTexel.y * int(viewWidth)) * 0x9E3779B1u
			                          + uint(frameCounter + 1) * 0x85EBCA77u);
			// [2026-08-19 离线渲染] 同帧多 SPP 漫反射追踪平均（对齐 RENDERING_MODE 思路：多射线 + 帧累积，
			// 而非仅屏噪靠时域磨）。seed inout 于循环内递增 → 每次独立方向。
			#ifdef OFFLINE_RENDER
				vec3 traceAcc = vec3(0.0);
				for (int s = 0; s < VOXEL_TRACE_OFFLINE_SPP; ++s) {
					traceAcc += VoxelTracePixel(mat3(gbufferModelViewInverse) * viewPos, worldNormal, geoNormal,
					                            -viewPos.z, skyLightmap, lightmap.x, renderTexel, s, traceSeed);
				}
				result = vec4(traceAcc * rcp(float(VOXEL_TRACE_OFFLINE_SPP)) * VOXEL_GI_TRACE_STRENGTH, 1.0);
			#else
			// [2026-08-21 实时 SPP] 实时模式也支持同帧多射线：VOXEL_TRACE_SPP 默认 1（现状），
			// 调大后多射线平均 → 单帧降噪、时域收敛更快（性能按比例增）。与离线宏独立。
				vec3 traceAcc = vec3(0.0);
				for (int s = 0; s < VOXEL_TRACE_SPP; ++s) {
					traceAcc += VoxelTracePixel(mat3(gbufferModelViewInverse) * viewPos, worldNormal, geoNormal,
					                            -viewPos.z, skyLightmap, lightmap.x, renderTexel, s, traceSeed);
				}
				result = vec4(traceAcc * rcp(float(VOXEL_TRACE_SPP)) * VOXEL_GI_TRACE_STRENGTH, 1.0);
			#endif
			#endif   // [2026-09-06] 关闭 VOXEL_CONE_GI #else（锥档分支结束）
		#else
			vec3 worldNormal = FetchSurfaceNormal(renderTexel);
			float lightmapSky = Unpack2x8UY(loadMaterialPack(renderTexel).x);

			result = CalculateSSILVB(screenCoord, viewPos, worldNormal, lightmapSky);
		#endif
		#if defined GI_ACTIVE_VXGI && defined VOXEL_REUSE
			// ---- ReSTIR：几何一致才与上帧均值合并，否则重置为新样本（避免转动/移动把旧几何混入残影）；随后记录本像素几何 ----
			{
				vec4 _pW = PingReusePrev(texelPos);
				// ① 本像素几何一致（绝对世界坐标）：平移/转动都会使其变化 → false → 重置为新样本。
			// 全局相机运动（_camMoved）时强制 false：本帧一律不复用/不合并，消除拖影与跳变。
			vec3 _wPrev = imageLoad(reservoirW, texelPos).xyz;
			bool _geoMatch = !_camMoved && (length(_wPrev - _wpos) / max(length(viewPos), 1e-4) < VOXEL_REUSE_GEO);
				if (_geoMatch) {
				    // ② 空间复用：仅静止一致时才合并上帧十字 4-邻域（绝对世界坐标一致）提样本。
				    // 平移/转动时不被启用，避免把旧视角邻居混入 → 消除拖影。
				    vec3 _accS = vec3(0.0); float _aS = 0.0; float _aM = _pW.a;
				    for (int _dir = 0; _dir < 4; ++_dir) {
				        ivec2 _delta = ivec2(0);
				        if (_dir == 0) _delta = ivec2( 0, -1);
				        else if (_dir == 1) _delta = ivec2( 1,  0);
				        else if (_dir == 2) _delta = ivec2( 0,  1);
				        else            _delta = ivec2(-1,  0);
				        ivec2 _av = texelPos + _delta;
				        if (clamp(_av, ivec2(0), (ivec2(viewWidth, viewHeight) >> 1) - 1) == _av) {
				            vec4 _nv = PingReusePrev(_av);
				            if (_nv.a > 0.5) {
				                vec3 _nwP = imageLoad(reservoirW, _av).xyz;
				                if (length(_nwP - _wpos) / max(length(viewPos), 1e-4) < VOXEL_REUSE_GEO) {
				                    _accS += _nv.rgb * _nv.a; _aS += _nv.a; _aM = max(_aM, _nv.a);
				                }
				            }
				        }
				    }
				    if (_aS > 0.05) { _pW.rgb = _accS / _aS; _pW.a = min(_aM, VOXEL_REUSE_MCAP); }
				}
				bool _valid = _geoMatch && _pW.a > 0.5;
				float _M = _valid ? min(_pW.a + 1.0, VOXEL_REUSE_MCAP) : 1.0;
				vec3 _mean = _valid ? ((_pW.rgb * _pW.a) + result.rgb) / (_pW.a + 1.0) : result.rgb;
				vec4 _crW = vec4(_mean, _M);
				if ((frameCounter & 1u) == 0u) imageStore(reservoirA, texelPos, _crW); else imageStore(reservoirB, texelPos, _crW);
				// 记录本像素"绝对世界坐标"作为下一帧一致性基准（RGBA32F 保远距离精度）
				imageStore(reservoirW, texelPos, vec4(_wpos, 0.0));
			}
#endif
			result.rgb = RGBToYCoCg(result.rgb); // Convert to YCoCg color space (for filtering)
		imageStore(colorimg3, texelPos, result);
	} else {
		imageStore(colorimg3, texelPos, vec4(0.0));
	}
}
