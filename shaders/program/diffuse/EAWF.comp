layout (local_size_x = 8, local_size_y = 8) in;
const vec2 workGroupsRender = vec2(0.5, 0.5);

//======// Utility //=============================================================================//

#include "/lib/Utility.glsl"

//======// Image //===============================================================================//

layout (rgba16f) restrict uniform image2D colorimg3;

//======// Uniform //=============================================================================//

#include "/lib/universal/Uniform.glsl"

//======// Function //============================================================================//

#include "/lib/universal/Random.glsl"
#include "/lib/universal/Fetch.glsl"
#include "/lib/universal/Transform.glsl"

//======// NRD 风格滤波参数 //==================================================================//
// [2026-08-19] hit-distance 世界空间滤波半径（NRD ReBLUR 思路）：
// 让每 pass 的空间滤波在"世界空间"近似恒定——近处物体每屏像素覆盖的世界范围小，
// 步长相应放大以覆盖同等世界半径；远处每个像素本就覆盖大世界范围，则步长收窄防过度模糊。
// 单位 = 米（目标世界半径）；0 = 关闭，用回固定的指数像素步长。
//
// 怎么调（值的效果随渲染分辨率/视角变化：pxPerWorldAtZ1 = halfViewSize.y * proj[1][1]）：
//   0 ~ 0.15   = 保守：基本只做"远处收窄防过糊"，近处几乎不放，细节最保真。
//   0.15 ~ 0.3 = 均衡（推荐 0.25）：近处温和放大 + 远处明显收窄，缓解近处欠滤波。
//   0.3 ~ 0.5  = 偏强：近处模糊加大、噪声更干净；可能开始出现点状闪烁 / 边缘发糊。
//   > 0.5      = 不建议：a-trous 每 pass 只有 9 个样本，步长过疏 → 点状闪烁。
// 巡检方向：
//   近景(底部/贴墙)出现闪烁小点   → 调小（说明步长已超 9-tap 支撑）。
//   远景依旧太糊、没改善          → 确认已 ≥0.2，若设大后闪点则回小并接受轻微欠滤。
#ifndef NRD_RADIUS
    #define NRD_RADIUS 0.25 // [0.0 0.05 0.1 0.15 0.2 0.3 0.5 0.75 1.0] 世界空间滤波半径（米）
#endif

