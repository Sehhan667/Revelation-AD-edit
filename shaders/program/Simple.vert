//======// Utility //=============================================================================//

#include "/lib/Utility.glsl"

//======// Uniform //=============================================================================//


//======// Main //================================================================================//
void main() {
	// Full screen triangle
	vec2 uv = vec2((gl_VertexID & 1) << 1, gl_VertexID & 2);
    // 渲染缩放：把全屏三角形缩到左下角画布。NO_SCALE 用于必须全屏运行的 pass（TAA/Grade/Final）。
    #if (RENDER_SCALE_1000X != 1000) && !defined NO_SCALE
        uv *= renderScale;
    #endif
    gl_Position = vec4(uv * 2.0 - 1.0, 0.0, 1.0);
}
