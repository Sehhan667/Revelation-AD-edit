#define PASS_CLOUD_SM

//======// Input //===============================================================================//

layout (local_size_x = 16, local_size_y = 16) in;
const ivec3 workGroups = ivec3(32, 32, 1);

//======// Utility //=============================================================================//

#include "/lib/Utility.glsl"

//======// Uniform //=============================================================================//

writeonly uniform image2D cloudShadowImg;

#include "/lib/universal/Uniform.glsl"

//======// SSBO //================================================================================//

#include "/lib/universal/SSBO.glsl"

//======// Function //============================================================================//

#include "/lib/universal/Random.glsl"

#include "/lib/atmosphere/Common.glsl"
#include "/lib/atmosphere/clouds/Shadows.glsl"

//======// Main //================================================================================//
void main() {
	ivec2 tid = ivec2(gl_GlobalInvocationID.xy);

	// [2026-11-16] 这张图的全部消费者都在 CLOUD_SHADOWS / VF_CLOUD_SHADOWS /
	// DEBUG_CLOUD_SHADOWS 里（DeferredLight、Translucent、AtmosphericFog、Final 的调试视图），
	// 三者默认全关 ⇒ 现在写出来的值没人读。整 pass 直接退出，
	// 否则「每帧全量刷新」会把这 512x512 的云层 raymarch 白算一遍（原先降频时只算 1/16）。
	#if !defined CLOUD_SHADOWS && !defined VF_CLOUD_SHADOWS && !defined DEBUG_CLOUD_SHADOWS
		return;
	#endif

    // [2026-11-16] 与 GenSkyMap 同款：刷新密度由 SKY_MAP_DOWNFREQ_REFRESH 统一控制，
    // 且是动态的 —— 掠射时段逐帧全量，其余时段 4x4 棋盘（16 帧一轮）。
	#ifdef SKY_MAP_DOWNFREQ_REFRESH
		bool sunGrazing = abs(worldSunDir.y) < sin(radians(SKY_REFRESH_FULL_SUN_ANGLE_DEG));
		ivec2 offset = checkerboardOffset4x4[frameCounter & 15];
		// [2026-08-09 修复] 与 GenSkyMap 同款：`(tid & 3) == offset` 是 bvec2 放进 if，
		// 非法 GLSL（部分驱动行为未定义），改为 all(equal(...)) 规范写法。
		bool writeTexel = sunGrazing || all(equal(tid & 3, offset)) || worldTimeChanged;
	#else
		bool writeTexel = true;
	#endif
	if (writeTexel) {
		float dither = BlueNoise(tid, frameCounter);

		vec2 uv = (vec2(tid) + dither) * rcp(textureSize(cloudShadowTex, 0));
        vec3 rayPos = SetupCloudShadowPos(uv);
        float cloudShadow = CalculateCloudShadows(rayPos, dither);

		// Accumulate
		float cloudShadowPrev = texelFetch(cloudShadowTex, tid, 0).x;
		cloudShadow = mix(cloudShadow, cloudShadowPrev, 0.95 * float(!worldTimeChanged));

		imageStore(cloudShadowImg, tid, vec4(cloudShadow));
	}
}
