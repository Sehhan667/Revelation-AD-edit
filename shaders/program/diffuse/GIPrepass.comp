/*
--------------------------------------------------------------------------------
  Revelation-AD-edit  —  REBLUR Prepass（官方 diffusePrepassBlurRadius = 30）
--------------------------------------------------------------------------------

  官方 NRD `ReblurSettings`：
      // (pixels) - pre-accumulation spatial reuse pass blur radius
      // (0 = disabled, must be used in case of badly defined signals and probabilistic sampling)
      float diffusePrepassBlurRadius = 30.0f;

  它的职责有两个（都在**累积之前**完成）：
  1. **空间重用**：把稀疏的 1 spp 噪声输入在 30 px 半径内加权平均，得到"稠密"的输入，
     这样时域累积器与后面的空间滤波面对的不再是大量 0；
  2. **归一化命中距离**：官方定义
         normHitDist = saturate( hitDistance / f )
         f = ( A + viewZ * B ) * lerp( 1, C, exp2( D * roughness^2 ) )
     A=3.0, B=0.1, C=20.0, D=-25.0；漫反射 roughness=1 时 exp2(-25)≈0 ⇒ 因子塌缩为 1
     ⇒ `f = A + viewZ * B`。该值写入输出 .a，供空间 pass 的 `minHitDistanceWeight` 使用。

  输出：colortex22（半分辨率，RGBA16F）
      rgb = 空间重用后的 YCoCg 输入
      a   = 归一化命中距离
--------------------------------------------------------------------------------
*/

//======// Input //===============================================================================//

layout (local_size_x = 8, local_size_y = 8) in;

//======// Utility //=============================================================================//

#include "/lib/Utility.glsl"

#ifdef VXGI_FULLRES
const vec2 workGroupsRender = vec2(1.0, 1.0);
#else
const vec2 workGroupsRender = vec2(0.5, 0.5);
#endif

//======// Uniform //=============================================================================//

layout (rgba16f) restrict uniform image2D colorimg22;   // 输出：rgb = 重用后输入，a = 归一化命中距离
layout (rgba16f) restrict uniform image2D colorimg24;   // 输出：r = 方差（官方在 prepass 里估方差）

#include "/lib/universal/Uniform.glsl"
#include "/lib/universal/Transform.glsl"
#include "/lib/universal/Fetch.glsl"

//======// Function //============================================================================//

// 官方默认参数（ReblurHitDistanceParameters）
#define REBLUR_HITDIST_A 3.0
#define REBLUR_HITDIST_B 0.1

// 30 px 半径 ⇒ 半分辨率 15 纹素。用 9x9/步长 2 采样，覆盖 ±16 画布纹素（≈ ±32 屏幕像素）。
// 与官方 30 px 同量级；单遍完成（官方内部实现细节不同，但半径与"无条件执行"这两点一致）。
#define PREPASS_RADIUS_TEXELS 8
#define PREPASS_STEP 2

void main() {
    ivec2 texelPos = ivec2(gl_GlobalInvocationID.xy);
#ifdef VXGI_FULLRES
    if (any(greaterThanEqual(texelPos, ivec2(viewSize)))) return;
    ivec2 rt = texelPos;
#else
    if (any(greaterThanEqual(texelPos, ivec2(halfViewSize)))) return;
    ivec2 rt = texelPos * 2 + checkerboardOffset2x2[frameCounter & 3u];
#endif

    float depth = loadDepth0(rt);
    float viewZ = ScreenToViewDepth(depth);
    vec3 normal = FetchSurfaceNormal(rt);

    // 注意：image2D 只能用 imageSize()，不能用 textureSize()（后者是 sampler 的重载）。
    // 这里直接用视口尺寸，语义等价且无重载风险。
#ifdef VXGI_FULLRES
    ivec2 canvasEnd = ivec2(viewSize);
#else
    ivec2 canvasEnd = ivec2(halfViewSize);
#endif
    vec3 sum = vec3(0.0);
    float wSum = 0.0;
    // 官方在 prepass 里估方差：用"参与空间重用的样本"的一阶/二阶矩，而不是对模糊后的结果再算
    //（后者必然≈0：32 px 模糊后相邻纹素几乎同值，实测诊断视图 2 全黑）。
    float lSum = 0.0;
    float lSum2 = 0.0;

    for (int dy = -PREPASS_RADIUS_TEXELS; dy <= PREPASS_RADIUS_TEXELS; dy += PREPASS_STEP) {
        for (int dx = -PREPASS_RADIUS_TEXELS; dx <= PREPASS_RADIUS_TEXELS; dx += PREPASS_STEP) {
            ivec2 t = texelPos + ivec2(dx, dy);
            if (clamp(t, ivec2(1), canvasEnd - 2) != t) continue;
            // 同帧视深（从 depthtex 取，避免跨帧口径）
#ifdef VXGI_FULLRES
            float nz = ScreenToViewDepth(loadDepth0(t));
#else
            float nz = ScreenToViewDepth(loadDepth0(t * 2 + checkerboardOffset2x2[frameCounter & 3u]));
#endif
            // 法线来自 colortex14（世界空间方向，跨帧安全）
            vec3 nrm = OctDecodeSnorm(texelFetch(colortex14, t, 0).xy);
            float w = saturate(1.0 - abs(nz - viewZ) / max(abs(viewZ) * 0.1, 1e-3));
            w *= linearstep(0.5, 0.9, saturate(dot(nrm, normal)));
            w *= 1.0 / (1.0 + float(dx * dx + dy * dy) * 0.01);   // 径向衰减
            vec3 tapCol = texelFetch(colortex3, t, 0).rgb;
            sum += tapCol * w;
            lSum  += tapCol.r * w;
            lSum2 += tapCol.r * tapCol.r * w;
            wSum += w;
        }
    }

    vec3 reused = wSum > 1e-4 ? sum / wSum : texelFetch(colortex3, texelPos, 0).rgb;

    // 原始命中距离（格，0..射程上限）：写在 colortex3.a（追踪端 `gHitDistance`）。
    // **不能** saturate，否则全部压成 1（永远视为很远）。归一化只在这里做一次（官方 front-end）。
    float hitDist = max(texelFetch(colortex3, texelPos, 0).a, 0.0);
    // ScreenToViewDepth 返回的是**负**视深（眼前为负）⇒ 必须取绝对值。
    // 原写法 max(viewZ, 0.0) 恒为 0，等价于分母恒为 A，大视距时甚至可能为负。
    float normHit = saturate(hitDist * rcp(REBLUR_HITDIST_A + abs(viewZ) * REBLUR_HITDIST_B));

    imageStore(colorimg22, texelPos, vec4(reused, normHit));

    // 加权方差：E[x²] - E[x]²（与 VarianceEstimate 的尺度保持一致：×16）
    float meanL = wSum > 1e-4 ? lSum / wSum : 0.0;
    // 存**原始**方差（不乘 16）：下游 VarianceEstimate 统一乘 16 保持量纲，
    // 这样这里的读数可以直接当"σ²"用，调试视图不必再凑刻度。
    float varL  = wSum > 1e-4 ? max(lSum2 / wSum - meanL * meanL, 0.0) : 0.0;
    imageStore(colorimg24, texelPos, vec4(varL, 0.0, 0.0, 1.0));
}