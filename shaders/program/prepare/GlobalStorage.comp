//======// Input //===============================================================================//

layout (local_size_x = 1, local_size_y = 1) in;
const ivec3 workGroups = ivec3(1, 1, 1);

//======// Utility //=============================================================================//

#include "/lib/Utility.glsl"

//======// Uniform //=============================================================================//

#include "/lib/universal/Uniform.glsl"

//======// SSBO //================================================================================//

#define SSBO_DECLARED_TPYE restrict
#include "/lib/universal/SSBO.glsl"

//======// Function //============================================================================//

#include "/lib/atmosphere/Common.glsl"
#include "/lib/atmosphere/clouds/Common.glsl"

// 帧时间 EMA 系数。0.1 ⇒ 时间常数约 10 帧（60 fps 下 ≈ 160 ms）：足以滤掉逐帧抖动与
// 单帧卡顿，又不会让累积上限对真实帧率变化反应过慢。cap 只影响降噪强度、不影响画面亮度，
// 所以帧率突变时慢半拍是安全的。
#define GI_FRAME_TIME_SMOOTHING 0.1

//======// Main //================================================================================//
void main() {
	// [2026-11-12 A1] 每帧清「受伤实体」标志。本帧 gbuffers_entities 遇到受伤实体像素时置位
	// （见 Entities.frag）；Final 的实体受击故障段据此整段跳过。prepare 排在所有 gbuffers 之前
	// （Iris 顺序：setup → begin → shadow → shadowcomp → prepare → gbuffers → deferred → composite → final）。
	global.hurtEntitySeen = 0u;

	// ---- 帧时间低通（官方 NRD README 的硬要求）----
	// "The FPS passed to this function must be low pass filtered to reduce reactions to
	//  transient drops (stutters)." 三个消费者（Accumulate / EAWF / GIStabilize）都直接
	// 拿它算 accumCap 与 framerateScale，用瞬时 frameTime 会让这三处整屏同步逐帧抽动。
	// 持久 SSBO 首帧为 0 ⇒ 直接取当前值，避免从 0 缓慢爬升把首帧 cap 打到下限。
	// frameTime <= 0（暂停/加载/异常）时**不更新**：若把 0 参与 EMA，平滑值会被拉向 0，
	// cap 随后撞到上限（128）⇒ 恢复后几十帧累积过粘、拖影明显。
	float _prevFrameTime = global.smoothedFrameTime;
	if (frameTime > 0.0) {
		global.smoothedFrameTime = _prevFrameTime > 1e-6
			? mix(_prevFrameTime, frameTime, GI_FRAME_TIME_SMOOTHING)
			: frameTime;
	}

	// [2026-11-12 logo 跟随] 相机朝向低通（yaw, pitch）。启动 logo 用「低通 - 当前」的差
	// 做「浮在镜头前、慢半拍跟上的板子」。LOGO_FOLLOW_DELAY = 0 时直接跟随（旧行为）。
	{
		vec3 camForward = -gbufferModelViewInverse[2].xyz;
		vec2 camView = vec2(atan(camForward.z, camForward.x), asin(clamp(camForward.y, -1.0, 1.0)));
		#if LOGO_FOLLOW_DELAY > 0.0
			// 首帧 SSBO 里还是 0，直接对齐当前朝向，避免 logo 从「yaw=0」慢慢爬过来
			if (frameCounter <= 1) global.logoLaggedView = camView;
			float followAlpha = 1.0 - exp(-max(frameTime, 1e-4) / LOGO_FOLLOW_DELAY);
			vec2 dView = global.logoLaggedView - camView;
			dView.x = mod(dView.x + PI, TAU) - PI;      // 处理 ±π 环绕（跨过 -180/180 度时不会甩一圈）
			global.logoLaggedView = global.logoLaggedView - dView * followAlpha;
		#else
			global.logoLaggedView = camView;
		#endif
	}

	// Compute illuminance
	vec3 sunIlluminance = sunIrradiance * AtmosphereTransmittanceToSun(atmosphereViewPos, worldSunDir);
	vec3 moonIlluminance = sunIrradiance * AtmosphereTransmittanceToSun(atmosphereViewPos, -worldSunDir) * moonlightMult;
	global.directIlluminance = 128.0 * (sunIlluminance + moonIlluminance);

	// Avoid the misalignment at sunrise and sunset
	global.directIlluminance *= smoothstep(0.0, 0.01, worldLightDir.y);

	#ifdef CLOUD_SHADOWS
		// [2026-11-12 B7] 正交范围 *32 -> *8。这张图是 512^2（cloudShadowImg 512x512）：
		// 原来范围 = CLOUD_SHADOW_DISTANCE*32 = 2048（半宽）⇒ 4096 格压进 512 纹素 = 8 格/纹素，
		// 而可见范围只有渲染距离那 ~200 格 —— 也就是 97% 的纹素根本没被采样到。
		// 收到 *8（默认 64 ⇒ 半宽 512 格，仍有余量）后同成本拿到 4 倍分辨率。
		// 采样侧（WorldToCloudShadowScreenPos）用同一个矩阵，所以只改这里即可。
		mat4 projMat = BuildOrthoMat(CLOUD_SHADOW_DISTANCE * 8.0, CLOUD_SHADOW_DISTANCE * 8.0, 0.0, cumulusTopRadius);
		cloud.shadowViewProj = projMat * shadowModelView;
		cloud.shadowViewProjInv = inverse(cloud.shadowViewProj);
	#endif
}