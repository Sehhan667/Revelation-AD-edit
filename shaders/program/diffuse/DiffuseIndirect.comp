//======// Input //===============================================================================//

layout (local_size_x = 16, local_size_y = 16) in;
const vec2 workGroupsRender = vec2(0.5, 0.5);

//======// Utility //=============================================================================//

#include "/lib/Utility.glsl"

//======// Uniform //=============================================================================//

writeonly restrict uniform image2D colorimg3;
#ifdef VOXEL_REUSE
    // ReSTIR reservoir 乒乓（image.reservoirA/B，imageLoad/imageStore，RGBA16F 半分辨率）
    layout (rgba16f) restrict uniform image2D reservoirA;
    layout (rgba16f) restrict uniform image2D reservoirB;
    // reservoirW 存"当前像素的绝对世界坐标"作为一致性基准。
    // 必须用绝对世界坐标（固定基准）而非 view 空间坐标：view 空间跟相机走，
    // 相机平移时同方向像素的 viewPos 几乎不变 → 检测不出平移 → 平移不重置 → 拖影。
    // 绝对世界坐标数值范围大，RGBA16F 在远距离精度不足 → 用 RGBA32F。
    layout (rgba32f) restrict uniform image2D reservoirW;
    // 全局相机运动跟踪器（见 shaders.properties image.camTracker）
    layout (rgba32f) restrict uniform image2D camTracker;
#endif

#include "/lib/universal/Uniform.glsl"

#ifdef VOXEL_REUSE
// ReSTIR 上帧乒乓 reservoir（按帧奇偶选 buffer）
vec4 PingReusePrev(ivec2 p) {
    return ((frameCounter & 1u) == 0u) ? imageLoad(reservoirB, p) : imageLoad(reservoirA, p);
}
#endif

//======// SSBO //================================================================================//

#include "/lib/universal/SSBO.glsl"

//======// Function //============================================================================//

#include "/lib/universal/Transform.glsl"
#include "/lib/universal/Fetch.glsl"
#include "/lib/universal/Random.glsl"

#include "/lib/atmosphere/Common.glsl"

#include "/lib/surface/BRDF.glsl"
#include "/lib/lighting/SSILVB.glsl"

//======// 追踪 SPP //==============================================================================//
// [2026-08-19] 离线模式每像素漫反射追踪光线数（同帧多射线平均，降低棋盘时域依赖，更快更干净）。
// 仅 OFFLINE_RENDER 时生效；实时模式仍为棋盘 1 SPP。
#ifndef VOXEL_TRACE_OFFLINE_SPP
    #define VOXEL_TRACE_OFFLINE_SPP 20
#endif
// [2026-08-21] 实时模式每像素每帧漫反射追踪光线数（SPP）。默认 1 = 现状（棋盘半分辨率 + 时域累积）；
// 调大同帧多射线平均 → 单帧更干净、时域收敛更快，但性能按比例下降（每射线一次 DDA 步进）。
// 与 OFFLINE_RENDER 的 VOXEL_TRACE_OFFLINE_SPP 独立：实时用本宏，离线用离线宏。
#ifndef VOXEL_TRACE_SPP
    #define VOXEL_TRACE_SPP 1 // [1 2 4 8 16 32 64]
#endif

#ifdef PROBE_GI_ENABLED
    // 探针 GI 信号源：16³ 平滑探针缓存 trilinear 查询（独立于 VXGI/SSILVB，见 lib/lighting/ProbeGI.glsl）
    #include "/lib/lighting/shadow/Common.glsl"
    uniform sampler2DShadow shadowtex1;
    uniform sampler2D atlas2D;   // VoxelData.glsl 的 VoxelGetAtlasCoord 引用 textureSize(atlas2D)
    uniform sampler3D voxelDataSampler;
    uniform usampler3D voxelLightSampler;
    #include "/lib/lighting/VoxelData.glsl"
    #include "/lib/lighting/VoxelSunShadow.glsl"
    #include "/lib/lighting/VoxelSkyLight.glsl"
    #include "/lib/lighting/ProbeGI.glsl"

    // [Plan B + 完整 DDGI 2026-09-03] 写端并入本 compute dispatch：乒乓写 B 读 A（不同纹理，同 dispatch 无冲突），
    // 彻底摆脱"额外写端 pass 是否被调度"的不确定性（fragment 写端在 deferred50 与 deferred22 均已证伪）。
    // 每探针一整块 O×O 八面体贴图：image.probeIrradiance/2（RGB=gamma 编码方向性辐照度，R dist 均值/方差）。
    // image 端负责写，sampler 端（probeIrradianceSampler/2 等，见 shaders.properties）负责读上一帧另一块。
    layout (rgba16f) restrict uniform image3D probeIrradiance;   // 读写（边界拷贝需图像端回读）
    layout (rgba16f) restrict uniform image3D probeIrradiance2;
    layout (rgba16f) restrict uniform image3D probeDistance;
    layout (rgba16f) restrict uniform image3D probeDistance2;


    // [2026-09-04 参考 IRC] voxelRadiance = VXGI 的 1m 逐格辐照度光场（deferred22 维护）。
    // 探针查询端直接三线性采样它 → 免 SVGF 的逐格 GI（方块/天/阳光在 IRC 逐格传播）。
    uniform sampler3D voxelRadianceSampler;
    uniform sampler3D voxelRadiance2Sampler;

    //============================================================================================//
    // ProbeTrace — 探针采样线（DDGI 风格，一阶弹射）
    // 从探针格心（体素空间连续坐标）沿方向 DDA 穿 voxelData 场景：
    // - 发射光体素 → 球形光源平滑贡献 + 穿透不挡光（VoxelHitLightSphere）
    // - 首实心命中 → 返回该面辐射度：方块光 + 阳光反弹(VoxelSunShadow 遮挡) + 天光底
    // - 出界/射程尽 → 返回方向天光（VoxelSkyColor）
    // 与 VoxelTracing 的差异：探针各向同性 → 无半球权重、无 IRC 自反弹（一阶弹射）。
    // 值 = 入射辐照度（后在 DeferredLight 乘 albedo）。DDA 复用 rdir 有符号修正等修复。
    // compute 安全：不用 VoxelSkyColor（其采大气 LUT，compute 未绑定 → NaN），改用 skyColor
    // × 地平线衰减；阳光只用体素 DDA（VoxelSunShadowTracing）+ SSBO global.directIlluminance。
    //============================================================================================//
    vec3 ProbeTrace(vec3 origin, vec3 dir, out float outDist) {
        // DDGI 距离场上限：网格格距的 1.5 倍（超出视为无遮挡物）。
        float maxRayDist = length(vec3(PROBE_SPACING)) * 1.5;
        outDist = maxRayDist;   // 默认：无遮挡物（出界/射程尽/只穿发射体素）

        vec3 voxelCoord = floor(origin);
        vec3 sdir = sign(dir);
        vec3 rdir = 1.0 / mix(dir, vec3(1e-30), lessThanEqual(abs(dir), vec3(1e-8)));
        vec3 totalStep = (sdir * (voxelCoord - origin + 0.5) + 0.5) * abs(rdir);
        vec3 contrib = vec3(0.0);
        vec3 tracingNext = step(totalStep, vec3(VoxelMin3(totalStep)));

        for (int i = 0; i < VOXEL_TRACE_DISTANCE; ++i) {
            float rayLength = 0.0;
            if (i > 0) {
                rayLength = VoxelMin3(totalStep);
                if (rayLength > float(VOXEL_TRACE_DISTANCE)) break;
                tracingNext = step(totalStep, vec3(rayLength));
                voxelCoord += tracingNext * sdir;
                totalStep += tracingNext * abs(rdir);
                if (any(lessThan(voxelCoord, vec3(0.0))) || any(greaterThanEqual(voxelCoord, vec3(float(VOXEL_AREA))))) break;
            }

            ivec3 vc = ivec3(voxelCoord);
            vec4 hvd = texelFetch(voxelDataSampler, vc, 0);
            if (hvd.z <= 0.5) continue;

            vec3 lD = unpackUnorm4x8(texelFetch(voxelLightSampler, vc, 0).r).rgb;
            if (lD.z > VOXEL_GI_EMISSIVE_THRESHOLD) {
                // 发射体素不挡光：累加其光球贡献并继续穿透（DDGI 的"发光体素沿路径累积"）。
                contrib += VoxelHitLightSphere(origin, dir, vec3(vc), VoxelLightColor(abs(hvd.z)));
                continue;
            }

            if (i == 0 && abs(hvd.z) <= 154.0) continue;

            VoxelRay vray;
            vray.ori = origin; vray.dir = dir; vray.rdir = rdir; vray.sdir = sdir;
            vec3 hitNormal;
            if (!IsHitBlock(vray, totalStep, tracingNext, voxelCoord, abs(hvd.z), rayLength, hitNormal)) continue;
            if (i == 0) rayLength = max(rayLength, 0.0);

            // 背面命中（法线背对射线）：探针大体在几何体内部。距离取负（用于遮挡场 abs），辐照度不计。
            if (dot(hitNormal, -dir) <= 0.0) {
                outDist = -rayLength;
                return vec3(0.0);
            }
            outDist = rayLength;

            vec3 alb = vec3(hvd.r, hvd.g, VoxelUnpack2xU8X(hvd.w));
            vec3 v = vec3(0.0);
            float hitSkylight = VoxelUnpack2xU8Y(hvd.w);

            if (lD.y > 0.01)
                v += max(alb, vec3(VOXEL_GI_BLOCK_MIN_ALBEDO)) * VoxelLightColor(abs(hvd.z)) * lD.y * VOXEL_GI_BLOCK_STRENGTH;

#if !defined PROBE_GI_BLOCK_ONLY && !defined IRC_DISABLE_SUN_GI
            // [临时 2026-09-03 PROBE_GI_BLOCK_ONLY=屏蔽阳光] 只留方块光调试时整体拿掉阳光项。
            if (worldId != -1) {
                // [FIX 2026-09-03 阳光按 VXGI IRC 对齐] 阳光亮度必须 ×128(同 VoxelTracing 的
                // *128.0);此前探针只有 sunIrradiance(≈1)不 ×128 → 阳光比 VXGI 暗 128 倍,
                // 是"只有方块光、无阳光"的根因。sunDir 用标准 worldSunDir(shadowModelViewInverse
                // 在 compute 无效)。有 SSBO 用 SSBO,否则本地重算 + 128.0 兜底。
                vec3 sunDir = worldSunDir;
                float NdotL = saturate(dot(sunDir, hitNormal));
                vec3 hitVoxelPos = origin + dir * rayLength;
                vec3 sunVis = vec3(VoxelSunShadowTracing(hitVoxelPos, sunDir));
                vec3 directIllum = sunIrradiance * 128.0;   // 同 VoxelTracing: sunIrradiance*128.0
                if (max(max(global.directIlluminance.r, global.directIlluminance.g), global.directIlluminance.b) > 1e-4)
                    directIllum = global.directIlluminance;
                if (max(max(directIllum.r, directIllum.g), directIllum.b) < 1e-4 && worldSunDir.y > 0.01)
                    directIllum = vec3(128.0);          // 兜底(同 VoxelTracing)
                // DDGI probe safety gate: only surfaces carrying real skylight
                // may receive bounced sunlight. This prevents cave roofs and
                // compute-context shadow misses from filling enclosed spaces.
                float sunSkyGate = smoothstep(0.20, 0.80, hitSkylight);
                v += alb * directIllum * NdotL * sunVis * sunSkyGate;
            }

            // [FIX 2026-09-03 底光按 VXGI 对齐] 用命中体素的真实 skylight(lightmap.y)而非硬编码 0.5,
            // 使洞穴/背阴的底光随 MC lightmap 变化(火把 block light 在 lightmap 里扩散)。
            vec3 shadowlight = sunIrradiance * rcp(max(luminance(sunIrradiance), 1e-4));
            #ifndef GI_ACTIVE_IRC
                v += alb * SimpleSkyLighting(skyColor, shadowlight, hitNormal.y, hitSkylight);
            #endif
#endif
            return v + contrib;   // 表面辐照度 + 沿途发射累积
        }

#ifndef PROBE_GI_BLOCK_ONLY
        if (worldId != -1) {
            float fade = VoxelSkyHorizonFade(dir);
            #ifndef GI_ACTIVE_IRC
                if (fade > 0.001) return max(skyColor * fade, vec3(0.0)) + contrib;
            #endif
        }
#endif
        return contrib;   // 射程用尽：只留发射累积，距离=无遮挡物
    }

    // 探针第 s 条线的方向（纯函数 hash，与主射线循环一致；写端纹素融合时重算以减少寄存器占用）。
    vec3 ProbeRayDir(ivec3 tid, int s) {
        vec3 b = vec3(tid.x, tid.y, tid.z);
        vec2 u = vec2(hash13(b * 7.13 + vec3(s * 1.7, s * 2.3, float(frameCounter))),
                      hash13(b * 11.7 + vec3(s * 3.1, s * 4.7, float(frameCounter) * 1.3)));
        return VoxelSphereUnitVectorFromU(u);
    }

    // 写一条探针图集纹素到正确的乒乓块（writeB：本帧写 B/1、读 A/0）。
    void ProbeStore(ivec3 cell, ivec2 octTexel, vec3 irr, vec2 dist, bool writeB) {
        ivec3 c = ProbeOctAtlasCoord(cell, octTexel);
        if (writeB) {
            imageStore(probeIrradiance2, c, vec4(irr, 1.0));
            imageStore(probeDistance2,   c, vec4(dist, 0.0, 0.0));
        } else {
            imageStore(probeIrradiance,  c, vec4(irr, 1.0));
            imageStore(probeDistance,    c, vec4(dist, 0.0, 0.0));
        }
    }

    // 边界纹素(0..O-1) → 与其镜像的内部纹素（局部 1-based，内部在 [1,N]；八面体缝折叠）。
    ivec2 ProbeBorderInterior(ivec2 b) {
        int O = PROBE_OCT_BORDER;
        int N = PROBE_OCT_SIZE;
        bool cx = (b.x == 0 || b.x == O - 1);
        bool cy = (b.y == 0 || b.y == O - 1);
        if (cx && cy)       return ivec2(b.x > 0 ? 1 : N, b.y > 0 ? 1 : N);
        else if (!cx && cy) return ivec2((O - 1) - b.x,    b.y > 0 ? N : 1);
        else                return ivec2(b.x > 0 ? N : 1,  (O - 1) - b.y);
    }

    // ProbeUpdateSlice：本 invocation 分摊更新若干探针（完整 DDGI 写端）。
    // 每探针一整块 O×O 八面体贴图：内 N×N 纹素 cos 加权融合 16 条线 + 重时域滞后累积；
    // 另存每条线命中距离的均值/平方（遮挡场）；边界 O²-N² 由内部镜像拷贝（八面体缝折叠）。
    void ProbeUpdateSlice(ivec2 pix) {
        int totalProbes = PROBE_GI_GRID_SIZE * PROBE_GI_GRID_SIZE * PROBE_GI_GRID_SIZE;
        // viewWidth/viewHeight 是 float（Uniform.glsl）；须先转 int 再右移（>> 只接受整型操作数）。
        int totalPixels = max((int(viewWidth) >> 1) * (int(viewHeight) >> 1), 1);
        int perPixel = max((totalProbes + totalPixels - 1) / totalPixels, 1);
        int pixIdx = pix.y * (int(viewWidth) >> 1) + pix.x;
        int ia = min(pixIdx * perPixel, totalProbes);
        int ib = min(ia + perPixel, totalProbes);

        // ---- DDGI 式网格重居中（世界锚定，整数格平移）----
        const float GRID_HALF = float(PROBE_GI_GRID_SIZE) * 0.5;
        vec3 gridOriginThis = (round(cameraPosition * rcp(PROBE_SPACING)) - GRID_HALF) * PROBE_SPACING;
        vec3 gridOriginPrev = (round(previousCameraPosition * rcp(PROBE_SPACING)) - GRID_HALF) * PROBE_SPACING;
        vec3 reCenter = (gridOriginThis - gridOriginPrev) * rcp(PROBE_SPACING);   // 整数格重居中偏移
        ivec3 reCenterI = ivec3(round(reCenter));

        // 本帧写 B → 旧值在 A；写 A → 旧值在 B（读上一帧另一块）。sampler 直接按帧奇偶传给 texelFetch，
        // 不做采样器局部变量（GLSL 更稳）。
        bool writeB = ((uint(frameCounter) & 1u) != 0u);

        const int R = PROBE_RAY_SAMPLES;         // 每探针平均每帧射线预算：总射线/帧 = 探针数 × R（与周期无关）
        const int uPeriod = PROBE_UPDATE_PERIOD; // 轮转周期：每帧只更新 1/uPeriod 探针，每个更新投 R×uPeriod 线
        const int RAY_CHUNK = 64;                // 分块追踪，避免大射线数组压爆寄存器/局部内存
        const int N = PROBE_OCT_SIZE;
        const int O = PROBE_OCT_BORDER;
        const float sp = PROBE_SPACING;
        const float gInv = 1.0 / PROBE_IRRADIANCE_GAMMA;
        const float maxRayDist = length(vec3(sp)) * 1.5;
        const float eps = 1e-9 * float(R);
        int G = PROBE_GI_GRID_SIZE;

        for (int vi = ia; vi < ib; ++vi) {
            int z = vi / (G * G);
            int y = (vi / G) % G;
            int x = vi % G;
            ivec3 tid = ivec3(x, y, z);

            // [2026-09-05 轮转分摊] 每帧更新 vi ≡ frameCounter (mod uPeriod) 的探针（每帧 1/uPeriod），
            // 每个更新一次投出 R×uPeriod 条射线 → 总射线量/帧与旧版一致，但单更新样本数 ×uPeriod、
            // 单更新方差 ÷uPeriod（小光源命中/落空抖动再降一档）。新暴露边缘探针强制立即更新播种。
            ivec3 oldCell = tid + reCenterI;
            bool oldInBounds = all(greaterThanEqual(oldCell, ivec3(0)))
                            && all(lessThan(oldCell, ivec3(G)));
            bool scheduled = (uPeriod <= 1) || ((vi % uPeriod) == (frameCounter % uPeriod));
            bool updateNow = scheduled || !oldInBounds;

            vec3 probeCenter = (gridOriginThis + (vec3(tid) + 0.5) * sp)
                             - vec3(cameraPositionInt) + float(VOXEL_RADIUS);

            if (updateNow) {
                // ---- 分块射线追踪：方向为纯函数 hash（融合时按需重算，不存方向），每块 RAY_CHUNK 线 ----
                const int NI = N * N;
                vec3 accRad[NI];
                float accW[NI];
                float accD[NI];
                float accD2[NI];
                float accDW[NI];
                for (int k = 0; k < NI; ++k) {
                    accRad[k] = vec3(0.0);
                    accW[k]   = 0.0;
                    accD[k]   = 0.0;
                    accD2[k]  = 0.0;
                    accDW[k]  = 0.0;
                }
                int raysTotal = R * max(uPeriod, 1);   // 本次更新投出的总射线数
                // [2026-09-05 轮转补偿] PROBE_HYSTERESIS 语义=每帧保留比例：P 帧才更新一次的探针，
                // 每更新的保留比例应取 hyst^P（而非 hyst^(1/P)！）：P=1 时退回 hyst，P>1 时每次更新
                // 混入 1-hyst^P，使"每 8 帧等效收敛速率"与逐帧 hyst 完全一致（响应、噪声特性都不随周期漂移）。
                const float hystUpd = pow(PROBE_HYSTERESIS,      float(max(uPeriod, 1)));
                const float distUpd = pow(PROBE_DIST_HYSTERESIS, float(max(uPeriod, 1)));
                for (int c0 = 0; c0 < raysTotal; c0 += RAY_CHUNK) {
                    int cEnd = min(c0 + RAY_CHUNK, raysTotal);
                    vec3 rayRad[RAY_CHUNK];
                    float rayDist[RAY_CHUNK];
                    for (int s = c0; s < cEnd; ++s) {
                        vec3 dir = ProbeRayDir(tid, s);
                        float dd = maxRayDist;
                        vec3 rad = ProbeTrace(probeCenter, dir, dd);
                        // NaN 防护：坏样本置 0（避免污染整个探针 → 缓存闪烁）。
                        if (!all(equal(rad, rad)) || any(lessThan(rad, vec3(0.0)))) rad = vec3(0.0);
                        rayRad[s - c0] = rad;
                        rayDist[s - c0] = dd < 0.0 ? dd : min(dd, maxRayDist);   // 背面记负（遮挡场用 abs）
                    }
                    // 本块并入各纹素累积器（与原版相同的 DDGI cos-加权语义）
                    for (int iy = 0; iy < N; ++iy) {
                        for (int ix = 0; ix < N; ++ix) {
                            ivec2 octTexel = ivec2(ix + 1, iy + 1);
                            vec3 texelDir = ProbeOctTexelDir(octTexel);
                            int k = iy * N + ix;
                            for (int s = 0; s < cEnd - c0; ++s) {
                                float w = max(0.0, dot(texelDir, ProbeRayDir(tid, c0 + s)));
                                if (w <= 1e-6) continue;
                                float d = min(abs(rayDist[s]), maxRayDist);
                                accDW[k] += w;
                                accD[k]  += d * w;
                                accD2[k] += d * d * w;
                                if (rayDist[s] >= 0.0) {   // 背面不计辐照度
                                    accRad[k] += rayRad[s] * w;
                                    accW[k]   += w;
                                }
                            }
                        }
                    }
                }

                // ---- 内部 N×N 纹素：汇总 + 重时域滞后累积 + 写距离场（与原版一致）----
                for (int iy = 0; iy < N; ++iy) {
                    for (int ix = 0; ix < N; ++ix) {
                        ivec2 octTexel = ivec2(ix + 1, iy + 1);
                        int k = iy * N + ix;

                        // 辐照度：ΣL·cos / (2·Σcos)（DDGI：除以 Σcos 而非 N 降方差，再补 1/2）
                        vec3 newIrrLin = accRad[k] * rcp(2.0 * max(accW[k], eps));
                        newIrrLin = min(newIrrLin, vec3(100.0));
                        vec3 newIrrEnc = pow(max(newIrrLin, vec3(0.0)), vec3(gInv));

                        // 距离场：cos 加权均值/二阶矩（背面用 abs 计入，供查询端 chebyshev 遮挡）
                        vec2 newDist = vec2(accD[k], accD2[k]) * rcp(2.0 * max(accDW[k], eps));

                        // 读旧值（重居中后同一 octant）→ 时域滞后混合
                        vec4 oldIrrV = vec4(0.0);
                        vec4 oldDistV = vec4(0.0);
                        if (oldInBounds) {
                            ivec3 oldCoord = ProbeOctAtlasCoord(oldCell, octTexel);
                            if (writeB) {
                                oldIrrV = texelFetch(probeIrradianceSampler, oldCoord, 0);
                                oldDistV = texelFetch(probeDistanceSampler, oldCoord, 0);
                            } else {
                                oldIrrV = texelFetch(probeIrradiance2Sampler, oldCoord, 0);
                                oldDistV = texelFetch(probeDistance2Sampler, oldCoord, 0);
                            }
                        }
                        bool oldValid = oldInBounds
                                     && abs(oldIrrV.a - 1.0) < 0.25
                                     && all(equal(oldIrrV.rgb, oldIrrV.rgb))
                                     && all(greaterThanEqual(oldIrrV.rgb, vec3(0.0)))
                                     && all(lessThan(oldIrrV.rgb, vec3(200.0)));

                        float hyst = oldValid ? hystUpd : 0.0;
                        vec3 outIrr;
                        if (oldValid) {
                            // RTXGI 时域：大变化降滞后；变暗时给最小步进避免卡死。
                            vec3 oldMean = oldIrrV.rgb;
                            vec3 delta = newIrrEnc - oldMean;
                            if (ProbeLum(delta) > 0.5) delta *= 0.25;
                            vec3 lerpDelta = (1.0 - hyst) * delta;
                            const float cThresh = 1.0 / 1024.0;
                            if (ProbeMaxComp(newIrrEnc) < ProbeMaxComp(oldMean)) {
                                // 变暗：给最小步进避免卡死。逐通道 min/max + 手写符（避免 max(float,vec3)/sign(vec3) 翻译问题）。
                                vec3 absDelta = abs(delta);
                                vec3 minStep  = min(max(abs(lerpDelta), vec3(cThresh)), absDelta);
                                lerpDelta = minStep * mix(vec3(-1.0), vec3(1.0), step(vec3(0.0), lerpDelta));
                            }
                            outIrr = oldMean + lerpDelta;
                        } else {
                            outIrr = newIrrEnc;   // 首帧/NaN/越界 → 重置
                        }
                        // 距离场用更快的滞后（几何静止，快速收敛 → 遮挡更快生效、少漏光）；同样做轮转补偿
                        vec2 outDist = mix(newDist, oldDistV.rg, oldValid ? distUpd : 0.0);

#ifdef DEBUG_PROBE_PLUMBING
                        // [写端强制测试 2026-09-03] 无视射线/混合/时域：每个探针的所有纹素直接写入
                        // 与"探针格心世界位置"绑定的彩色渐变（12m 周期）。配合自检显示端读回 →
                        // 画面应见彩色 4m 方块并钉在世界。判读：
                        //   有彩色方块 → 写→存→读 链路通，真实 GI 黑 = 射线值/混合问题（查 ProbeTrace）；
                        //   仍黑/无画面 → 写端没在跑（dispatch/绑定/纹理尺寸问题）。
                        outIrr = fract((gridOriginThis + (vec3(tid) + 0.5) * sp) * rcp(16.0));
                        outDist = vec2(10.0, 100.0);   // 大距离场 = 不遮挡（避免测试图被 cheb 压黑）
#endif

                        ProbeStore(tid, octTexel, outIrr, outDist, writeB);
                    }
                }

                memoryBarrierImage();

#ifdef PROBE_ATLAS_FILTER
                // ---- [2026-09-05 RTXGI 式八面体图集双边滤波] 写入后对本探针 N×N 内部纹素做 3×3
                // 边缘保持平滑：邻域权重 = 方向相似度^DIR_POW × 距离边缘 exp2(-Δmean²·DIST_K)。
                // 目的：火把/萤石这类小光源"命中/落空"的逐纹素高方差被邻域摊平 → 低频浮动大幅减轻，
                // 不增加任何射线预算。只滤辐照度、不滤距离场（滤距离会增加穿墙漏光风险）。
                // 邻域 clamp 到内部 [1..N]：此刻边界环还是上一帧内容（镜像拷贝在本块之后执行），
                // 不许读旧环；clamp 后与中心重合的邻居跳过（避免边缘纹素被中心重复加权过度平滑）。
                {
                    const float fltK = PROBE_ATLAS_FILTER_DIST_K;
                    const float dirPow = PROBE_ATLAS_FILTER_DIR_POW;
                    for (int iy = 1; iy <= N; ++iy) {
                        for (int ix = 1; ix <= N; ++ix) {
                            ivec2 cTexel = ivec2(ix, iy);
                            ivec3 cAtlas = ProbeOctAtlasCoord(tid, cTexel);
                            vec4 cIrr = writeB ? imageLoad(probeIrradiance2, cAtlas) : imageLoad(probeIrradiance, cAtlas);
                            if (cIrr.a < 0.5 || !all(equal(cIrr.rgb, cIrr.rgb))) continue;
                            vec4 cDist = writeB ? imageLoad(probeDistance2, cAtlas) : imageLoad(probeDistance, cAtlas);
                            vec3 cDir = ProbeOctTexelDir(cTexel);
                            vec3 acc = cIrr.rgb;   // 中心权重 = 1
                            float accW = 1.0;
                            for (int dy = -1; dy <= 1; ++dy) {
                                for (int dx = -1; dx <= 1; ++dx) {
                                    if (dx == 0 && dy == 0) continue;
                                    ivec2 nTexel = clamp(cTexel + ivec2(dx, dy), ivec2(1), ivec2(N));
                                    if (nTexel == cTexel) continue;   // 被 clamp 回中心的重复邻居
                                    ivec3 nAtlas = ProbeOctAtlasCoord(tid, nTexel);
                                    vec4 nIrr = writeB ? imageLoad(probeIrradiance2, nAtlas) : imageLoad(probeIrradiance, nAtlas);
                                    if (nIrr.a < 0.5 || !all(equal(nIrr.rgb, nIrr.rgb))) continue;
                                    vec4 nDist = writeB ? imageLoad(probeDistance2, nAtlas) : imageLoad(probeDistance, nAtlas);
                                    float wDist = exp2(-sqr(nDist.r - cDist.r) * fltK);
                                    float wDir  = pow(max(dot(cDir, ProbeOctTexelDir(nTexel)), 0.0), dirPow);
                                    float w = wDist * wDir;
                                    acc += nIrr.rgb * w;
                                    accW += w;
                                }
                            }
                            if (accW > 1e-6) {
                                vec4 filtered = vec4(acc * rcp(accW), 1.0);
                                if (writeB) imageStore(probeIrradiance2, cAtlas, filtered);
                                else        imageStore(probeIrradiance,  cAtlas, filtered);
                            }
                        }
                    }
                    memoryBarrierImage();
                }
#endif
            } else {
                // ---- 轮转未轮到：把上一帧旧值（含重居中整数搬移）原样搬入当前乒乓块 ----
                // 保证查询端按帧奇偶读到的"另一块"永远是最近一帧的值；否则轮转会读到 2 帧前的旧数据。
                // 走到此处必有 scheduled=false 且 oldInBounds=true（updateNow 定义），搬移源有效。
                // 旧块本帧无人写（全帧只写另一块），imageLoad 直读安全；各线程只写自己探针的图集区域。
                for (int iy = 1; iy <= N; ++iy) {
                    for (int ix = 1; ix <= N; ++ix) {
                        ivec2 octTexel = ivec2(ix, iy);
                        ivec3 curAtlas = ProbeOctAtlasCoord(tid, octTexel);
                        ivec3 oldAtlas = ProbeOctAtlasCoord(oldCell, octTexel);
                        if (writeB) {
                            imageStore(probeIrradiance2, curAtlas, imageLoad(probeIrradiance, oldAtlas));
                            imageStore(probeDistance2,   curAtlas, imageLoad(probeDistance,   oldAtlas));
                        } else {
                            imageStore(probeIrradiance,  curAtlas, imageLoad(probeIrradiance2, oldAtlas));
                            imageStore(probeDistance,    curAtlas, imageLoad(probeDistance2,   oldAtlas));
                        }
                    }
                }
                memoryBarrierImage();
            }

            // ---- 边界 O²-N² 纹素：由本探针内部镜像拷贝（同线程已写，imageLoad 可靠回读）----
            for (int by = 0; by < O; ++by) {
                for (int bx = 0; bx < O; ++bx) {
                    if (bx >= 1 && bx <= N && by >= 1 && by <= N) continue;   // 内部已写
                    ivec2 src = ProbeBorderInterior(ivec2(bx, by));          // 内部 1-based
                    ivec3 cSrc = ProbeOctAtlasCoord(tid, src);
                    ivec3 cDst = ProbeOctAtlasCoord(tid, ivec2(bx, by));
                    if (writeB) {
                        imageStore(probeIrradiance2, cDst, imageLoad(probeIrradiance2, cSrc));
                        imageStore(probeDistance2,   cDst, imageLoad(probeDistance2,   cSrc));
                    } else {
                        imageStore(probeIrradiance,  cDst, imageLoad(probeIrradiance,  cSrc));
                        imageStore(probeDistance,    cDst, imageLoad(probeDistance,    cSrc));
                    }
                }
            }
        }
    }
#endif
// [2026-09-05 IRC_GI] deferred23(VoxelGI.comp) 维护的 voxelRadiance IRC(64³×1m) 辐照度光场。
// IRC_GI 查询端直接三线性采样（×0.01）。声明放在 PROBE_GI_ENABLED 块【外】，PROBE 关闭时也不缺声明。
#if defined GI_ACTIVE_IRC && !defined PROBE_GI_ENABLED
    uniform sampler3D voxelRadianceSampler;
    uniform sampler3D voxelRadiance2Sampler;
#endif
// [管线自检 2 引用锚点] Iris GUI 布尔开关显示条件：必须单独一行 #ifdef。
#ifdef DEBUG_PROBE_QUERY
#endif
// [GUI 布尔锚点 2026-09-05] IRC_DISABLE_SUN_GI（屏蔽 IRC/DDGI 阳光反弹，仅方块光/自发光调试）。
#ifdef IRC_DISABLE_SUN_GI
#endif
// [GUI 布尔锚点 2026-09-05] PROBE_ATLAS_FILTER（探针图集双边滤波开关）。
#ifdef PROBE_ATLAS_FILTER
#endif
// [GUI 布尔锚点 2026-09-06] VOXEL_COARSE_ACCEL / VOXEL_FINE_ACCEL / VOXEL_COS_SAMPLING（VXGI 追踪加速/采样）。
#ifdef VOXEL_COARSE_ACCEL
#endif
