/*
--------------------------------------------------------------------------------
  Revelation-AD-edit  —  REBLUR 主历史保留（默认不掺滤波结果，仅保留 A/B 开关）
--------------------------------------------------------------------------------

  官方口径（NRD v4.11）：
      主历史（main history）只累积**输入信号**；空间滤波结果不写回主历史，
      它只进入 TemporalStabilization 的稳定化结果（colortex23），作为最终输出。
  这一点由 README 原文确认："Fast history is the input signal, accumulated for a few frames.
  Fast history helps to minimize lags in the main history, which is accumulated for more frames."
  早期版本的「滤波结果回写 0.6」会让空间核逐帧复合，细节被慢慢抹平；
  现在默认不回写（0.0），仅保留 GI_BISECT bit1 作为 A/B 开关。

  本 pass 因此只做一件事：把 Accumulate 写好的长历史原样保留（可选 A/B 回写）。
  关闭（VOXEL_GI_NRD 未定义）时本 pass 不调度，pipeline 与改动前一致。
--------------------------------------------------------------------------------
*/

//======// Input //===============================================================================//

layout (local_size_x = 8, local_size_y = 8) in;

//======// Utility //=============================================================================//

#include "/lib/Utility.glsl"

// 与 GI 画布同分辨率（默认半分辨率棋盘；VOXEL_GI_FULLRES 全分辨率）。须在 Utility 之后。
#ifdef VXGI_FULLRES
const vec2 workGroupsRender = vec2(1.0, 1.0);
#else
const vec2 workGroupsRender = vec2(0.5, 0.5);
#endif

//======// Uniform //=============================================================================//

layout (rgba16f) restrict uniform image2D colorimg2;             // 长历史（下一帧 Accumulate 的输入）
layout (rgba16f) restrict readonly uniform image2D colorimg3;    // 本帧 EAWF 滤波结果

#include "/lib/universal/Uniform.glsl"

//======// Main //================================================================================//

void main() {
    ivec2 texelPos = ivec2(gl_GlobalInvocationID.xy);

#ifdef VXGI_FULLRES
    if (any(greaterThanEqual(texelPos, ivec2(viewSize)))) return;
#else
    if (any(greaterThanEqual(texelPos, ivec2(halfViewSize)))) return;
#endif

    // 此时：colortex2 = Accumulate 本帧的「时域混合」结果（滤波前），.a = 累积帧数 a；
    //       colortex3 = EAWF 四遍滤波后的结果。
    // 官方口径：主历史不掺空间滤波结果（滤波只进稳定化 colortex23）。
    // 默认 0.0；GI_BISECT bit1 打开时用 0.6 做 A/B 对比（旧行为）。
    float _wb = ((GI_BISECT & 2) != 0) ? 0.6 : 0.0;
    // 不回写时 colortex2 已是 Accumulate 的输出，本 pass 无事可做。
    if (_wb <= 0.0) return;

    vec4 mixed = imageLoad(colorimg2, texelPos);
    vec3 filtered = imageLoad(colorimg3, texelPos).rgb;
    vec3 history = mix(mixed.rgb, filtered, _wb);

    // .a 保留累积帧数（Accumulate 下一帧的计数）；只替换 rgb。
    imageStore(colorimg2, texelPos, vec4(history, mixed.a));
}