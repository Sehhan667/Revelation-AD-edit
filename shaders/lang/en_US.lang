option.VISUALIZE_VOXELS=Voxel Visualization
option.VISUALIZE_VOXELS.comment=Overlays voxel colors on block albedo to inspect the voxelization result
option.VOXEL_GI_EMISSIVE_THRESHOLD=Emissive Threshold
option.VOXEL_GI_EMISSIVE_THRESHOLD.comment=Blocks whose PBR emissive is below this value are not treated as light sources
option.VOXEL_GI_BOOST=Emissive Boost
option.VOXEL_GI_BOOST.comment=Light energy multiplier for emissive voxels
